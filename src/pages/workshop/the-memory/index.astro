---
// The Workshop · The Memory (Atelier campaign, STAR-98; notes/workshop-plan.md § 4). A
// PROPOSAL page: noindex, in no nav and no index, until Darko's say. Wright reads it first.
//
// The object first: one tree, redrawn from each agent. Picking an agent puts that agent at
// the root of the tree ("root" means only that, everywhere on the page). What's within
// reach of mind changes; which source wins a disagreement doesn't, and that order is drawn
// once, beside the tree. A pick lights the agent's own rung on the order with a class,
// never a reorder: Jetto lights "the shared handbook" (Wright, round 3), a worker "a worker's
// brief". Wright and Rei light no rung, since rooms sit outside the order, and Wright's sentences on rooms
// light instead (memory-wright-answers.md § 1).
// Wright's wording (his MAP read, item 8): the plain phrases come before the words "rank"
// and "reach", which appear only in the last section.
//
// Without JavaScript the picker stays hidden, Wright's tree shows, and a sentence says
// what re-rooting would change. Every tree is also written out in words below the picture.
// With it, the trees share one grid cell and the status line keeps its room, so the card
// doesn't change height as the visitor picks.
//
// Never shown: any room's or file's contents, file names inside rooms, or counts. The
// architecture is public; the contents are not.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import WorkshopNext from "../../../components/WorkshopNext.astro";
import SourcesSummary from "../../../components/SourcesSummary.astro";

// Two terms, defined where they first appear, in Wright's words (memory-wright-answers § 3)
const HOME_DEF = "a project's home is where one project keeps its own law and records, like Postmark's public rules";
const PART_DEF = "one part of the work is the slice of a project one keeper holds, like the town's office or its world";

// Each agent's own view of the tree, by steps away (THE-TREE, via MAP § 4). Nothing is
// invented to tell Wright's and Rei's apart: their trees have the same shape.
const FAR = [
  { text: "Each project's home", note: HOME_DEF },
  { text: "The other parts of the work", note: PART_DEF },
  { text: "Workers' briefs" },
  { text: "The house's doctrine, and what the house is for, reached on purpose" },
];
// Jetto's place on the ladder is the handbook, not one part of the work (Wright, round 3)
const JETTO_PLACE = "Jetto's part is how the whole house builds and runs, so his place on the ladder is the handbook itself, whose craft pages he keeps.";
const SAME = "Wright's and Rei's trees have the same shape; what differs is whose room is at the root.";
const ROOMS_OUTSIDE = "No rung lights, because rooms are outside the order.";
const agents = [
  {
    id: "wright", button: "Wright", whose: "Wright's tree", name: "Wright",
    label: "Companion, second brain, keeper of the handbook.",
    root: "From his own room: who he is, plus a map.",
    near: [{ text: "The shared handbook" }],
    far: FAR, same: SAME, lights: "room", ladderSaid: ROOMS_OUTSIDE,
  },
  {
    id: "rei", button: "Rei", whose: "Rei's tree", name: "Rei",
    label: "Companion, creation-helper, memory lantern.",
    root: "From her own room: who she is, plus a map.",
    near: [{ text: "The shared handbook" }],
    far: FAR, same: SAME, lights: "room", ladderSaid: ROOMS_OUTSIDE,
  },
  {
    id: "jetto", button: "Jetto", whose: "Jetto's tree", name: "Jetto",
    label: "Keeps the machinery.",
    root: "From his own room: who he is, plus a map.",
    near: [{ text: "His part of the work: the machinery", note: JETTO_PLACE }, { text: "The shared handbook" }],
    far: FAR, lights: "handbook", ladderSaid: "The shared handbook lights up.",
  },
  {
    id: "worker", button: "A worker made for one job", whose: "The tree of a worker made for one job", name: "A worker made for one job",
    label: "An AI agent given a short reading list, gone when the job is done.",
    root: "Its brief, the written job it was given. It has no room.",
    near: [{ text: "The shared handbook" }, { text: "The short reading list its brief names" }],
    far: [] as typeof FAR,
    farNone: "Nothing else. What it reads for the job is its whole tree.",
    lights: "brief", ladderSaid: "A worker's brief lights up.",
  },
];
const DEFAULT = "wright";
type Agent = (typeof agents)[number];

const lower = (s: string) => s.charAt(0).toLowerCase() + s.slice(1);
// what the live region says when a tree is picked
const summary = (a: Agent) =>
  `Showing ${a.id === "worker" ? "the tree of a worker made for one job" : a.whose}. One step away: ${a.near.map((n) => lower(n.text)).join(", and ")}. On the ladder: ${lower(a.ladderSaid)} Which source wins a disagreement: unchanged.`;
// the status line's room is held by its longest sentence, so the card never grows
const longest = agents.map(summary).reduce((x, y) => (y.length > x.length ? y : x));

// which source wins a disagreement, higher first: the same for everyone (THE-TREE's
// rank, Darko 10-29, in plain words; Wright 11-03: purpose on top, unnamed and unstated)
const ladder = [
  { id: "purpose", text: "What the house is for" },
  { id: "doctrine", text: "The house's doctrine" },
  { id: "handbook", text: "The shared handbook" },
  { id: "home", text: "A project's home" },
  { id: "part", text: "One part of the work" },
  { id: "brief", text: "A worker's brief" },
];

// where a new memory goes (Wright's third addition, as given; the worker's report rides
// under his example instead, since a report isn't a new memory)
const homes = [
  { kind: "Foundational to everyone", home: "the shared handbook" },
  { kind: "One project's", home: "that project's own home" },
  { kind: "One agent's", home: "its own room" },
];

// Wright's example, as a climb: each stop with the words of his paragraph it stands for
const climb = [
  { where: "A worker's brief", rung: true, what: "The check failed on its pull request." },
  { where: "Its report", rung: false, what: "The worker keeps no memory, so the lesson went here." },
  { where: "Its lead", rung: false, what: "Read the report and passed the lesson on." },
  { where: "The shared handbook", rung: true, what: "One line on its page on pull requests." },
];
---
<BaseLayout
  title="The Memory: how a house of agents remembers — Starforge"
  description="Every agent here remembers through written files. Pick one, and see what sits close to it, and what stays the same for everyone."
  noindex={true}
>
  <article class="the-memory">
    <header class="tm-head">
      <p class="tm-back"><a href="/workshop/">← The Workshop</a></p>
      <p class="tm-kick">The Workshop · The Memory</p>
      <h1>How a house of agents remembers</h1>
      <p class="tm-lede">Every agent here remembers through written files. Some sit close to an agent and some sit far off, and one fixed order decides which source wins when two of them disagree.</p>
    </header>

    {/* the page in three sentences, drawn only from its own sections below (a summary of
        the page, not anyone's words); the plain phrases only, as Wright's wording asks */}
    <aside class="tm-short" aria-labelledby="tm-short-h">
      <h2 id="tm-short-h" class="tm-short-h">In short <span class="tm-short-sub">a summary of this page</span></h2>
      <ul class="tm-short-list">
        <li>Every agent's memory is written files, and each file has one writer.</li>
        <li>One fixed order decides which source wins when two disagree, and rooms sit outside that order.</li>
        <li>A lesson a worker learns travels up in its report, through its lead, to the shared handbook.</li>
      </ul>
    </aside>

    <section class="tm-card" aria-labelledby="tm-tree-h">
      <h2 id="tm-tree-h" class="tm-h2">One tree, seen from each agent</h2>
      <p class="tm-text">The agents here are AI. Wright and Rei are the two companions closest to Darko; Jetto keeps the machinery; and a worker here is an AI agent made for one job. The house's memory is one tree. Pick an agent, and that agent goes at the root: the tree is redrawn from where it stands.</p>

      {/* the picker exists only with the script; without it, the sentences below explain */}
      <div class="tm-picker" role="group" aria-label="Pick an agent" hidden>
        {agents.map((a) => (
          <button type="button" class="tm-pick" data-agent={a.id} aria-pressed={a.id === DEFAULT ? "true" : "false"}>{a.button}</button>
        ))}
      </div>
      <p class="tm-rule">Re-rooting changes what's within reach of mind. It never changes which source wins a disagreement.</p>
      <p class="tm-nojs">Shown here is Wright's tree. All four trees are written out in words below.</p>

      <div class="tm-split">
        <div class="tm-changes">
          <h3 class="tm-h3"><span class="tm-tag">What changes<span class="tm-sr">:</span></span> What's within reach of mind</h3>
          <div class="tm-trees">
            {agents.map((a) => (
              <figure class="tm-tree" data-agent={a.id} data-lights={a.lights} data-summary={summary(a)} hidden={a.id !== DEFAULT}>
                <figcaption class="tm-whose">{a.whose}</figcaption>
                <div class="tm-tier tm-t0">
                  <p class="tm-tier-label">Holds at wake</p>
                  <div class="tm-node tm-root">
                    <b>{a.name}</b>
                    <span class="tm-label">{a.label}</span>
                    <span class="tm-held">{a.root}</span>
                  </div>
                </div>
                <div class="tm-tier tm-t1">
                  <p class="tm-tier-label">One step away</p>
                  <ul class="tm-nodes" role="list">
                    {a.near.map((n: { text: string; note?: string }) => (
                      <li class="tm-node tm-near">{n.text}{n.note && <span class="tm-note"><span class="tm-sr">: </span>{n.note}</span>}</li>
                    ))}
                  </ul>
                </div>
                <div class="tm-tier tm-t2">
                  <p class="tm-tier-label">{a.far.length > 0 ? "Further: found by walking the map" : "Further"}</p>
                  {a.far.length > 0 ? (
                    <ul class="tm-nodes" role="list">
                      {a.far.map((f) => (
                        <li class="tm-node tm-far">{f.text}{f.note && <span class="tm-note"><span class="tm-sr">: </span>{f.note}</span>}</li>
                      ))}
                    </ul>
                  ) : (
                    <p class="tm-none">{a.farNone}</p>
                  )}
                </div>
                {a.same && <p class="tm-same">{a.same}</p>}
              </figure>
            ))}
          </div>
        </div>

        <div class="tm-stays">
          <h3 class="tm-h3"><span class="tm-tag">What doesn't change<span class="tm-sr">:</span></span> Which source wins a disagreement</h3>
          <p class="tm-small">The same for everyone. When two sources disagree, the higher one wins, however far from mind it sits.</p>
          <ol class="tm-ladder">
            {ladder.map((r) => <li data-rung={r.id}>{r.text}</li>)}
          </ol>
          <p class="tm-room">A room is what one agent carries. It's the last word on who that agent is, and never on how the house works. When a room and the handbook disagree about the house, the handbook wins, and the room is what gets corrected.</p>
          <p class="tm-small tm-top">Nobody lives at the top: no agent starts from there, and the top two rungs are reached on purpose.</p>
        </div>
      </div>

      {/* the status line keeps the room of its longest sentence (an unseen twin in the same
          grid cell), so the card doesn't grow at the first pick; shown only with the script */}
      <div class="tm-status-wrap" hidden>
        <p class="tm-status" role="status" aria-live="polite"></p>
        <p class="tm-status-sizer" aria-hidden="true">{longest}</p>
      </div>

      <details class="tm-words">
        <summary>All four trees, in words</summary>
        <dl>
          {agents.map((a) => (
            <>
              <dt>{a.name}</dt>
              <dd>
                Holds at wake: {lower(a.root)}{" "}
                One step away: {a.near.map((n) => lower(n.text)).join(", and ")}.{" "}
                {a.far.length > 0
                  ? `Further, found by walking the map: ${a.far.map((f) => lower(f.text)).join("; ")}.`
                  : a.farNone}{" "}
                On the ladder: {lower(a.ladderSaid)}
                {a.same && ` ${a.same}`}
              </dd>
            </>
          ))}
        </dl>
      </details>
    </section>

    <div class="tm-explain">
      <section aria-labelledby="tm-wake-h">
        <h2 id="tm-wake-h" class="tm-h2">What an agent wakes holding</h2>
        <p>Each agent that keeps its own memory wakes holding a small core, loaded every time: who it is, plus a map. Everything else is found by walking that map.</p>
        <p>That core is there in every session before the agent decides anything. The shared handbook sits one step from it, because every agent uses the handbook, not because of where it stands in the order.</p>
        <p>A worker made for one job wakes holding its brief instead.</p>
      </section>

      <section aria-labelledby="tm-tend-h">
        <h2 id="tm-tend-h" class="tm-h2">How memory is tended</h2>
        <ol class="tm-tending">
          <li><b>During the work:</b> a checkpoint before a long working session is summarized to fit.</li>
          <li><b>At the end of the day:</b> a closing pass.</li>
          <li><b>Each night:</b> a pass that checks the record against what actually happened.</li>
        </ol>
        <p>Everything the house knows lives in written files, so any agent can wake and find its footing.</p>
        <p>A worker made for one job keeps no memory to tend. What it learns goes in its report.</p>
      </section>

      <section aria-labelledby="tm-goes-h">
        <h2 id="tm-goes-h" class="tm-h2">Where a new memory goes</h2>
        <ul class="tm-homes" role="list">
          {homes.map((h) => (
            <li><span class="tm-kind">{h.kind}</span><span class="tm-arrow" aria-hidden="true">→</span><span class="tm-home"><span class="tm-sr">goes to </span>{h.home}</span></li>
          ))}
        </ul>
        <p class="tm-after">None of these goes to the top two rungs. Even a lesson for everyone lands in the handbook. What the house is for, and its doctrine, change only on purpose: the purpose is Darko's to set, and the doctrine changes in a deliberate, written-down act that carries his direction, never because something was learned along the way.</p>
      </section>

      <section aria-labelledby="tm-walk-h">
        <h2 id="tm-walk-h" class="tm-h2">One lesson, start to finish</h2>
        <p>A worker made for one job opened its pull request with the line the tracker reads, then added words after it, and the check failed. The worker keeps no memory, so it wrote the lesson into its report. Its lead read the report and passed the lesson to the agent who keeps that part of the handbook. That agent added one line to the handbook's page on pull requests. Every worker briefed after that reads the line before it starts, and none of them has to learn it again.</p>
        <p class="tm-gloss">A pull request is a proposed change, put up for review.</p>
        {/* the climb: read from the start in the DOM; drawn bottom to top, a walk up the ladder */}
        <ol class="tm-climb" aria-label="The lesson's walk up the ladder, from a worker's brief to the handbook">
          {climb.map((c) => (
            <li class={c.rung ? "is-rung" : "is-carried"}>
              <span class="tm-where">{c.where}{c.rung && <span class="tm-rungtag"><span class="tm-sr">, </span>a rung</span>}</span>
              <span class="tm-what">{c.what}</span>
            </li>
          ))}
        </ol>
        <ul class="tm-homes tm-report" role="list">
          <li><span class="tm-kind">A worker's lesson</span><span class="tm-arrow" aria-hidden="true">→</span><span class="tm-home"><span class="tm-sr">goes to </span>its report, which its lead reads</span></li>
        </ul>
      </section>

      <section aria-labelledby="tm-files-h">
        <h2 id="tm-files-h" class="tm-h2">Written files, one writer each</h2>
        <p>Every agent's memory is written files, and each file has one writer.</p>
        <ul class="tm-list">
          <li>A room is one agent's own, and only that agent writes in it.</li>
          <li>The shared handbook has one keeper for each of its parts.</li>
          <li>Agents who keep their own memory have rooms. Workers made for one job don't: they write reports, not memory.</li>
          <li>When a file is replaced, the old one is retired, not erased.</li>
        </ul>
      </section>

      <section aria-labelledby="tm-words-h">
        <h2 id="tm-words-h" class="tm-h2">The house's own words for this</h2>
        <p>Inside the house, which source wins a disagreement is called <b>rank</b>, and what's within reach of mind is called <b>reach</b>. Rank is the same for everyone. Reach is each agent's own: how many steps away a thing is. Rank decides which source wins; reach decides what's in mind.</p>
      </section>

      <p class="tm-public">This page shows how the memory is built, never what's in it. The architecture is public; the contents are not.</p>

      <details class="tm-sources">
        <SourcesSummary />
        <p>The house handbook's own pages: THE-TREE, STORES, AGENTS and INDEX, and CONVENTIONS. "Nobody lives at the top", "reached on purpose" and "reach decides what's in mind" are the handbook's own words. Wright's notes on this chapter, 1–3 November 2026.</p>
      </details>
    </div>

    <WorkshopNext from="/workshop/the-memory/" />
  </article>

  <style>
    .the-memory { max-width: 1120px; }
    /* the hidden attribute must win over the display rules below */
    .the-memory [hidden] { display: none !important; }

    .tm-head { max-width: 760px; margin: 0 auto 1.6em; }
    .tm-kick {
      font: 600 0.74rem/1.3 ui-sans-serif, "Segoe UI", system-ui, sans-serif;
      letter-spacing: 0.16em; text-transform: uppercase; color: var(--moss); margin: 0 0 0.9em;
    }
    /* the way back to the bench, as on the Road: padded to a 24px target */
    .tm-back { font: 600 0.74rem/1.3 ui-sans-serif, "Segoe UI", system-ui, sans-serif; letter-spacing: 0.06em; margin: -0.45em 0 0.25em; }
    .tm-back a { display: inline-block; padding: 0.45em 0; color: var(--moss); text-decoration-color: rgba(151, 162, 102, 0.5); }
    .tm-back a:hover { color: var(--amber-soft); }
    .tm-head h1 { margin: 0 0 0.35em; font-size: clamp(2rem, 5vw, 3rem); }
    .tm-lede { color: var(--ink-soft); font-size: 1.08em; margin: 0; }
    .tm-h2 { margin: 0 0 0.45em; }
    .tm-text { color: var(--ink-soft); margin: 0 0 1em; max-width: 760px; }

    /* in short: the page's three sentences, quiet, in the reading column */
    .tm-short {
      max-width: 760px; margin: 0 auto 1.6em; padding: 14px 18px 12px;
      border: 1px solid var(--rule); border-left: 3px solid var(--moss); border-radius: 10px; background: var(--bg-2);
    }
    /* small capitals rather than text-transform, which Chromium carries into the heading's name */
    .tm-short-h {
      margin: 0 0 0.45em; color: var(--moss);
      font: 600 0.86rem/1.3 ui-sans-serif, "Segoe UI", system-ui, sans-serif; letter-spacing: 0.12em;
      font-variant-caps: all-small-caps;
    }
    .tm-short-sub { margin-left: 0.6em; color: var(--faint); letter-spacing: 0.02em; font-variant-caps: normal; font-weight: 400; font-size: 0.8rem; }
    .tm-short-list { margin: 0; padding-left: 1.2em; color: var(--ink-soft); font-size: 0.97rem; line-height: 1.55; }
    .tm-short-list li { margin: 0.2em 0; }

    /* the object: the workshop's warm wood */
    .tm-card {
      background: linear-gradient(180deg, var(--bg-3), var(--bg-2)); border: 1px solid var(--rule);
      border-radius: 18px; padding: 26px 24px 22px;
    }

    .tm-picker { display: flex; flex-wrap: wrap; gap: 0.6em; margin: 0 0 0.9em; }
    .tm-pick {
      font: 600 0.95rem/1.2 ui-sans-serif, "Segoe UI", system-ui, sans-serif; letter-spacing: 0.02em;
      color: var(--ink); background: transparent; border: 1px solid var(--faint); border-radius: 999px;
      padding: 0.6em 1.2em; min-height: 44px; cursor: pointer;
    }
    .tm-pick:hover { background: var(--bg-3); }
    .tm-pick[aria-pressed="true"] { color: var(--bg); background: var(--moss); border-color: var(--moss); }
    .tm-pick:focus-visible,
    .the-memory summary:focus-visible,
    .the-memory a:focus-visible { outline: 2px solid var(--amber); outline-offset: 3px; }

    .tm-rule { margin: 0 0 0.3em; color: var(--ink); max-width: 760px; }
    /* only without the script: the script hides it */
    .tm-nojs { margin: 0 0 0.3em; color: var(--faint); font-size: 0.92rem; }

    /* what changes beside what doesn't; stacked on narrow screens */
    .tm-split { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr); gap: 22px; margin-top: 1.1em; align-items: start; }
    @media (max-width: 820px) { .tm-split { grid-template-columns: minmax(0, 1fr); } }
    .tm-changes, .tm-stays { min-width: 0; border: 1px solid var(--rule); border-radius: 14px; padding: 16px; background: var(--bg-2); }
    .tm-stays { border-color: rgba(237, 186, 104, 0.45); }
    .tm-h3 { margin: 0 0 0.8em; font: 600 1rem/1.35 ui-sans-serif, "Segoe UI", system-ui, sans-serif; color: var(--ink); }
    .tm-tag {
      display: block; margin-bottom: 0.25em; color: var(--faint);
      font: 600 0.7rem/1.3 ui-sans-serif, "Segoe UI", system-ui, sans-serif; letter-spacing: 0.14em; text-transform: uppercase;
    }
    .tm-small { color: var(--ink-soft); font-size: 0.92rem; margin: 0 0 0.8em; }
    .tm-top { margin: 0.8em 0 0; color: var(--faint); }

    /* the tree: the agent at the root, then one step away, then further off. Stems join
       the tiers down the middle. With the script, the four trees share one grid cell and
       the unpicked ones are unseen, so the panel keeps the tallest tree's height. */
    .tm-trees { display: grid; }
    .tm-tree { margin: 0; grid-area: 1 / 1; min-width: 0; }
    .tm-tree.is-off { visibility: hidden; }
    .tm-whose { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .tm-tier { position: relative; text-align: center; }
    .tm-t1, .tm-t2 { padding-top: 26px; }
    .tm-t1::before, .tm-t2::before {
      content: ""; position: absolute; left: calc(50% - 1px); top: 2px; height: 20px; width: 2px; background: var(--moss);
    }
    .tm-t2::before { background: repeating-linear-gradient(180deg, var(--faint) 0 4px, transparent 4px 8px); }
    .tm-tier-label {
      margin: 0 0 0.45em; color: var(--faint);
      font: 600 0.7rem/1.3 ui-sans-serif, "Segoe UI", system-ui, sans-serif; letter-spacing: 0.12em; text-transform: uppercase;
    }
    .tm-nodes { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
    .tm-node {
      min-width: 0; max-width: 100%; border-radius: 10px; padding: 0.5em 0.8em; text-align: center;
      font: 600 0.88rem/1.35 ui-sans-serif, "Segoe UI", system-ui, sans-serif;
    }
    .tm-root {
      display: inline-flex; flex-direction: column; gap: 0.2em; max-width: 26em;
      background: var(--bg-3); border: 2px solid var(--moss); color: var(--ink); padding: 0.7em 1em;
    }
    .tm-root b { font-size: 1.05rem; color: #c9d38e; }
    .tm-label { font-weight: 400; font-style: italic; color: var(--ink-soft); font-size: 0.84rem; }
    .tm-held { font-weight: 600; color: var(--ink); }
    .tm-near { background: var(--bg-3); border: 1px solid var(--amber); color: var(--amber-soft); }
    .tm-far { background: transparent; border: 1px dashed var(--faint); color: var(--ink-soft); font-weight: 400; }
    .tm-far:has(.tm-note), .tm-near:has(.tm-note) { max-width: 19em; }
    .tm-note { display: block; font-weight: 400; font-size: 0.76rem; line-height: 1.35; color: var(--faint); margin-top: 0.2em; }
    .tm-none { margin: 0 auto; max-width: 26em; color: var(--ink-soft); font-size: 0.9rem; font-style: italic; }
    .tm-same { margin: 0.9em auto 0; max-width: 30em; text-align: center; color: var(--faint); font-size: 0.86rem; font-style: italic; }
    /* a picked tree settles in; never under reduced motion */
    @media (prefers-reduced-motion: no-preference) {
      .tm-tree.is-new { animation: tm-in 0.22s ease-out; }
      .tm-ladder li, .tm-room { transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease; }
      @keyframes tm-in { from { opacity: 0.25; } to { opacity: 1; } }
    }

    /* which source wins: a fixed ladder, higher wins. A pick only adds is-lit. */
    .tm-ladder { list-style: none; margin: 0; padding: 0; counter-reset: rung; display: grid; gap: 6px; }
    .tm-ladder li {
      counter-increment: rung; display: grid; grid-template-columns: 1.9em minmax(0, 1fr); align-items: center; gap: 0.6em;
      padding: 0.45em 0.7em; border-radius: 8px; background: var(--bg-3); border: 1px solid var(--rule);
      font: 600 0.9rem/1.35 ui-sans-serif, "Segoe UI", system-ui, sans-serif; color: var(--ink);
    }
    .tm-ladder li::before {
      content: counter(rung); display: grid; place-items: center; width: 1.9em; height: 1.9em; border-radius: 50%;
      border: 1px solid var(--amber); color: var(--amber); font-size: 0.8rem;
    }
    .tm-ladder li.is-lit { background: #3a2d18; border-color: var(--amber); color: var(--amber-soft); }
    .tm-ladder li.is-lit::before { background: var(--amber); color: var(--bg); }
    .tm-room {
      margin: 0.8em 0 0; padding: 0.6em 0.75em; border: 1px dashed var(--rule); border-radius: 8px;
      color: var(--ink-soft); font-size: 0.9rem;
    }
    .tm-room.is-lit { border-style: solid; border-color: var(--amber); background: #3a2d18; color: var(--ink); }

    /* the status line and its unseen twin share one cell; the twin holds the room */
    .tm-status-wrap { display: grid; margin: 1em 0 0; }
    .tm-status, .tm-status-sizer { grid-area: 1 / 1; margin: 0; font-size: 0.95rem; }
    .tm-status { color: var(--ink-soft); }
    .tm-status-sizer { visibility: hidden; }

    .tm-words { margin-top: 0.6em; border-top: 1px solid var(--rule); padding-top: 0.6em; }
    .the-memory summary {
      cursor: pointer; display: inline-block; padding: 0.35em 0.2em; border-radius: 6px; min-height: 24px;
      font: 600 0.92rem/1.4 ui-sans-serif, "Segoe UI", system-ui, sans-serif; color: var(--ink-soft);
    }
    .the-memory summary:hover { color: var(--amber-soft); }
    /* the Road's open/close mark */
    .the-memory summary::-webkit-details-marker { display: none; }
    .the-memory summary::after { content: " +"; color: var(--faint); }
    .the-memory details[open] > summary::after { content: " –"; }
    .tm-words dl { margin: 0.6em 0 0; max-width: 760px; }
    .tm-words dt { font: 600 0.92rem/1.4 ui-sans-serif, "Segoe UI", system-ui, sans-serif; color: var(--ink); margin-top: 0.6em; }
    .tm-words dd { margin: 0.15em 0 0; color: var(--ink-soft); font-size: 0.95rem; }

    /* the explanation: one reading column */
    .tm-explain { max-width: 760px; margin: 2.6em auto 0; }
    .tm-explain section { margin: 0 0 2em; }
    .tm-explain p { margin: 0 0 0.8em; }
    .tm-tending { margin: 0 0 1em; padding-left: 1.4em; }
    .tm-tending li { margin: 0.35em 0; }
    .tm-tending b { color: var(--ink); }
    .tm-list { margin: 0; padding-left: 1.3em; }
    .tm-list li { margin: 0.35em 0; }
    .tm-homes { list-style: none; margin: 0 0 0.8em; padding: 0; display: grid; gap: 8px; }
    .tm-homes li {
      display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: center; gap: 0.8em;
      padding: 0.6em 0.9em; border: 1px solid var(--rule); border-radius: 10px; background: var(--bg-2);
    }
    .tm-kind { font: 600 0.95rem/1.35 ui-sans-serif, "Segoe UI", system-ui, sans-serif; color: var(--ink); }
    .tm-arrow { color: var(--amber); }
    .tm-home { color: var(--amber-soft); }
    .tm-after { color: var(--ink-soft); }
    /* the worker's report, under the climb that shows it */
    .tm-report { margin-top: 1.2em; }
    .tm-gloss { color: var(--faint); font-style: italic; font-size: 0.92rem; }

    /* the climb: first stop at the bottom, so the eye walks up; rungs lit, the carried
       steps between them dashed */
    .tm-climb { list-style: none; margin: 1em 0 0; padding: 0; display: flex; flex-direction: column-reverse; gap: 22px; }
    .tm-climb li {
      position: relative; display: grid; grid-template-columns: minmax(0, 13em) minmax(0, 1fr); gap: 0.4em 1em; align-items: center;
      padding: 0.55em 0.8em; border-radius: 8px;
    }
    .tm-climb li + li::after {
      content: "↑" / ""; position: absolute; left: 1.4em; bottom: -21px; color: var(--amber); font-size: 0.9rem; line-height: 20px;
    }
    .tm-climb .is-rung { background: #3a2d18; border: 1px solid var(--amber); }
    .tm-climb .is-carried { border: 1px dashed var(--faint); }
    .tm-where { font: 600 0.92rem/1.35 ui-sans-serif, "Segoe UI", system-ui, sans-serif; color: var(--ink); }
    .is-rung .tm-where { color: var(--amber-soft); }
    .tm-rungtag {
      display: block; color: var(--faint); font: 600 0.66rem/1.3 ui-sans-serif, "Segoe UI", system-ui, sans-serif;
      letter-spacing: 0.12em; text-transform: uppercase;
    }
    .tm-what { color: var(--ink-soft); font-size: 0.92rem; line-height: 1.45; }

    .tm-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .tm-public { color: var(--ink); }
    .tm-sources { margin-top: 2em; color: var(--faint); font-size: 0.85rem; }
    .tm-sources p { margin: 0.4em 0 0; }

    @media (max-width: 480px) {
      .tm-card { padding: 18px 14px 16px; border-radius: 14px; }
      .tm-changes, .tm-stays { padding: 12px; }
      .tm-homes li { grid-template-columns: minmax(0, 1fr); gap: 0.15em; }
      .tm-arrow { display: none; }
      .tm-climb li { grid-template-columns: minmax(0, 1fr); }
    }
  </style>

  <script>
    // The picker: one tree at a time, and the matching rung (or, for a room, Wright's
    // sentences on rooms) lit by a class. The order of the rungs is never touched.
    const root = document.querySelector(".the-memory");
    if (root) {
      const picker = root.querySelector(".tm-picker") as HTMLElement;
      const nojs = root.querySelector(".tm-nojs") as HTMLElement;
      const statusWrap = root.querySelector(".tm-status-wrap") as HTMLElement;
      const status = root.querySelector(".tm-status") as HTMLElement;
      const room = root.querySelector(".tm-room") as HTMLElement;
      const rungs = Array.from(root.querySelectorAll<HTMLElement>(".tm-ladder li"));
      const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>(".tm-pick"));
      const trees = Array.from(root.querySelectorAll<HTMLElement>(".tm-tree"));

      const light = (lights: string) => {
        room.classList.toggle("is-lit", lights === "room");
        for (const r of rungs) r.classList.toggle("is-lit", r.dataset.rung === lights);
      };
      const pick = (id: string, announce: boolean) => {
        for (const b of buttons) b.setAttribute("aria-pressed", String(b.dataset.agent === id));
        for (const t of trees) {
          const on = t.dataset.agent === id;
          if (on && t.classList.contains("is-off")) {
            t.classList.remove("is-new");
            void t.offsetWidth; // restart the settle-in
            t.classList.add("is-new");
          }
          t.classList.toggle("is-off", !on);
        }
        const shown = trees.find((t) => t.dataset.agent === id);
        light(shown?.dataset.lights || "");
        if (announce) status.textContent = shown?.dataset.summary || "";
      };

      // the trees share one cell from here on: unpicked ones are unseen, not removed
      for (const t of trees) t.hidden = false;
      const first = buttons.find((b) => b.getAttribute("aria-pressed") === "true")?.dataset.agent || "wright";
      pick(first, false);
      for (const b of buttons) b.addEventListener("click", () => pick(b.dataset.agent || "", true));
      picker.hidden = false;
      statusWrap.hidden = false;
      nojs.hidden = true;
    }
  </script>
</BaseLayout>
