---
// The Workshop · The Walls (Atelier campaign, STAR-98; notes/workshop-plan.md § 2). A
// PROPOSAL page: noindex, in no nav, until Darko's say. The bench links it in later.
// The rules that hold, and what earned each. The keystone is CANON § 6, the principle the
// stones answer to (Wright's ruling 6, 2026-11-02); its sentence is whole, and Darko may
// strike it (Q-P4). Five stones: warm brown faces, paper backs (Rei's call 3). Each face
// states a rule; each back gives what happened, what was learned, what it protects and
// where it applies, sourced to notes/walls-stones.md as ruled by Wright (ANSWERS.md,
// "Wright on the Walls' sourcing sheet"). A date appears only where the record gives one.
//
// Every word is in the HTML: without JavaScript, each stone shows its face and its back.
// The inline script below the wall turns each face into a real button (aria-expanded) and
// lays the stones face up, except the first, which stays turned over so the gesture is
// shown before it's asked for. It runs as the page parses, so the wall doesn't jump.
// Styles are global and namespaced under .the-walls, since the script builds the buttons.
import BaseLayout from "../../../layouts/BaseLayout.astro";

type Stone = {
  id: string;
  rule: string;
  turned?: boolean;
  happened: string;
  learned: string;
  protects: string;
  applies: string;
  history?: { label: string; text: string; old?: boolean }[];
};

// Copy is plain HTML strings, written here (set:html); nothing in them comes from outside.
const stones: Stone[] = [
  {
    // turned over at load: its record is the plainest, a dated delete and what it led to
    id: "delete-nothing",
    rule: "Delete nothing.",
    turned: true,
    happened:
      "On 30 October 2026, a worker's delete command reached Darko's permission prompt. From then on, Wright's rule has been that every worker's brief carries these walls in writing (Wright's record). On 31 October and 1 November, two workers cleared files out of working copies they didn't hold.",
    learned: "A worker in a shared working copy can't tell what's safe to remove.",
    protects: "Work and records that aren't the worker's.",
    applies:
      "Every worker that builds or checks. A worker lists what should go, and leaves it. Deleting happens on Darko's word, for a named list. A campaign's own branches are outside this rule, by Darko's ruling of 2 November 2026.",
  },
  {
    id: "never-prompt",
    rule: "Never run a command that can prompt.",
    happened:
      "Darko made it a rule on 25 October, at 23:54, through Wright. It's the rule that “Delete nothing” grew from.",
    learned:
      "A command that stops to ask is abandoned and reported, never waited on. Deleting is the commonest trigger, so a brief puts the rule in its practical form: don't delete; name what should go.",
    protects: "Every other worker running at the same time. One prompt stalls every worker until Darko answers it.",
    applies: "Every worker, on every command it runs. A worker running unattended uses commands that never stop to ask.",
  },
  {
    id: "publish",
    rule: "Building a change isn't the decision to publish it.",
    happened:
      "On this site, a merge to <code>main</code> is a publish: a page the build stops making disappears from the live site. Checking each pull request one by one for fit had turned into reviewing code. At 09:10 Eastern on 2 November 2026, Darko ruled the current form.",
    history: [
      {
        label: "Until 09:10 on 2 November 2026",
        old: true,
        text: "A merge to <code>main</code> deploys, so Darko merges, or says go for a named pull request. The campaign's workers never merge.",
      },
      {
        label: "Since then",
        text: "A campaign's own branches are its own to organize, merge and delete. A merge to <code>main</code> deploys, so every merge to <code>main</code> is Darko's and Wright's, decided on the campaign's build debrief, and Wright carries it out.",
      },
    ],
    learned:
      "Whether the right thing was built is a different question from whether the code is correct. The first is Darko's and Wright's, read from an account of what was built. The second belongs to the worker that reviews the code.",
    protects:
      "What the public sees, and the decision itself: what goes public is decided by people reading what was built, not by the worker that built it.",
    applies:
      "On this site. Only a merge to <code>main</code> publishes, and that merge is Darko's and Wright's, from a debrief. Postmark, the house's main work, ships differently: its code goes out by a weekly train with Darko's approval, and a release tag.",
  },
  {
    id: "never-grades",
    rule: "A builder never grades its own work.",
    happened: "On 8 October, fresh reviewers found a real defect the lane's own tests had passed.",
    learned:
      "The builder holds the design and tests what it built. The reviewer holds the ruling and asks what the build does at its edges, reading it “against the ruling, not against the builder's account of it.”",
    protects:
      "The match between what was asked for and what was built. A builder's own tests can share its blind spots, and a test can even pin a flaw in place as if it were wanted.",
    applies:
      "Every pairing of a builder and a reviewer in the house. “Done” is written down before building, and a worker that didn't build the change checks it.",
  },
  {
    id: "own-copy",
    rule: "Every worker has its own copy, and claims it first.",
    happened:
      "On 9 July, a reset in another agent's live working copy earned this rule, and Wright named it “the single most important discipline.” The house's shelf of these rules opens with how most of them were earned: “lanes lost trees, wiped each other's untracked work, and stalled the night.” (A tree is a working copy.)",
    learned:
      "Ask “whose copy is this?” before any write. A copy has one owner at a time. Claiming it is the first command on a copy, nothing touches it until the claim succeeds, and a refused claim stops the worker.",
    protects: "Other workers' work in progress, including files not yet committed and test runs still going.",
    applies:
      "Postmark's shared working copies, which a worker claims by name before touching and releases when it hands in. This site's campaign builds in copies of its own. The first question, whose copy this is, applies everywhere.",
  },
];

const parts: { key: "happened" | "learned" | "protects" | "applies"; label: string }[] = [
  { key: "happened", label: "What happened" },
  { key: "learned", label: "What was learned" },
  { key: "protects", label: "What it protects" },
  { key: "applies", label: "Where it applies" },
];
---
<BaseLayout
  title="The Walls: the rules that hold — Starforge"
  description="The rules that hold the house's work together, and what earned each."
  noindex={true}
>
  <article class="the-walls">
    <header class="wl-head">
      <p class="wl-back-link"><a href="/workshop/">← The Workshop</a></p>
      <p class="wl-kick">The Workshop · The Walls</p>
      <h1>The rules that hold</h1>
      <p class="wl-lede">A few firm rules hold the house's work together. Each stone below states one on its face. Turn it over to read what happened, what was learned, what the rule protects and where it applies.</p>
    </header>

    <section class="wl-keystone" aria-labelledby="wl-key-h">
      <h2 id="wl-key-h" class="wl-label">The keystone</h2>
      <figure class="wl-key">
        <blockquote class="wl-key-stone">
          <p>Make the relevant state visible; keep the next move reversible where possible; identify the first irreversible boundary; sign off <strong>there</strong>, not everywhere; don't let cadence, automation, or confidence silently become authority.</p>
        </blockquote>
        <figcaption class="wl-key-cap">The house canon, § 6: “Preserve the Questionable Moment.” Canonized 17 May 2026.</figcaption>
      </figure>
      <p class="wl-key-note">No single repair earned it. It's the principle every stone below answers to.</p>
    </section>

    <section class="wl-wall" aria-labelledby="wl-wall-h">
      <h2 id="wl-wall-h" class="wl-label">The stones</h2>
      <p class="wl-intro">A worker here is an AI agent made for one job, such as building a change or checking one; the house calls each one a lane. The first stone is already turned over.</p>

      <ul class="wl-stones" role="list">
        {stones.map((s) => (
          <li class="wl-stone" id={`stone-${s.id}`} data-turned={s.turned ? "" : undefined}>
            <h3 class="wl-face"><span class="wl-rule">{s.rule}</span></h3>
            <div class="wl-back" id={`back-${s.id}`}>
              <dl class="wl-parts">
                {parts.map((p) => (
                  <div class={`wl-part wl-part-${p.key}`}>
                    <dt>{p.label}</dt>
                    <dd set:html={s[p.key]} />
                  </div>
                ))}
              </dl>
              {s.history && (
                <div class="wl-history">
                  <p class="wl-history-h">The rule's wording, kept when it changed</p>
                  <div class="wl-versions">
                    {s.history.map((v) => (
                      <div class={v.old ? "wl-version is-old" : "wl-version"}>
                        <p class="wl-version-h">{v.label}{v.old && <span class="wl-tag"> · superseded</span>}</p>
                        <p set:html={v.text} />
                      </div>
                    ))}
                  </div>
                </div>
              )}
            </div>
          </li>
        ))}
      </ul>
    </section>

    <script is:inline>
      // Each face becomes a button that turns its stone over. Without this script every
      // back stays shown, so every word is readable. The animation lives in CSS, under
      // prefers-reduced-motion: no-preference only.
      (function () {
        var wall = document.querySelector(".the-walls .wl-stones");
        if (!wall) return;
        var stones = wall.querySelectorAll(".wl-stone");
        for (var i = 0; i < stones.length; i++) (function (stone) {
          var face = stone.querySelector(".wl-face");
          var rule = face.querySelector(".wl-rule");
          var back = stone.querySelector(".wl-back");
          var btn = document.createElement("button");
          btn.type = "button";
          btn.className = "wl-turn";
          btn.setAttribute("aria-controls", back.id);
          var hint = document.createElement("span");
          hint.className = "wl-hint";
          hint.setAttribute("aria-hidden", "true");
          btn.appendChild(rule);
          btn.appendChild(hint);
          face.appendChild(btn);
          stone.classList.add("is-live");
          var set = function (open, animate) {
            btn.setAttribute("aria-expanded", open ? "true" : "false");
            hint.textContent = open ? "Turn it back" : "Turn it over";
            stone.classList.toggle("is-turned", open);
            back.hidden = !open;
            back.classList.remove("is-turning");
            if (open && animate) {
              void back.offsetWidth; // restart the animation on a quick second turn
              back.classList.add("is-turning");
            }
          };
          back.addEventListener("animationend", function () { back.classList.remove("is-turning"); });
          btn.addEventListener("click", function () { set(btn.getAttribute("aria-expanded") !== "true", true); });
          set(stone.hasAttribute("data-turned"), false);
        })(stones[i]);
      })();
    </script>

    <aside class="wl-sources" aria-labelledby="wl-src-h">
      <h2 id="wl-src-h">Sources</h2>
      <ul>
        <li><b>The keystone:</b> the house canon, § 6, “Preserve the Questionable Moment” (canonized 17 May 2026).</li>
        <li><b>Delete nothing:</b> LANE-DISCIPLINE and MOVES-AND-STATES (house handbook); Wright's record, 30 October 2026; the Plumb lane's instructions (Wright, 1 November 2026); ARTI § 5 (Darko's ruling, 2 November 2026, 09:10 EST).</li>
        <li><b>Never run a command that can prompt:</b> LANE-DISCIPLINE (house handbook), with Darko's rule of 25 October, 23:54, via Wright.</li>
        <li><b>Building a change isn't the decision to publish it:</b> ARTI § 5 and EXPERT-CONTRACT (house handbook), with Darko's ruling of 2 November 2026, 09:10 EST, and the version of ARTI before it (Darko, 2 November 2026, 08:39 EST); this campaign's brief, before and after that ruling; Wright's ruling on Postmark's shipping, 2 November 2026.</li>
        <li><b>A builder never grades its own work:</b> STAFFING-AND-REVIEW, TRUEY and ARTI (house handbook).</li>
        <li><b>Every worker has its own copy, and claims it first:</b> LANE-DISCIPLINE and ARTI (house handbook).</li>
        <li><b>The page's shape:</b> Rei's read of the Workshop sketch and Wright's rulings on this page's sources, 2 November 2026.</li>
      </ul>
    </aside>
  </article>

  <style is:global>
    .the-walls {
      --wl-face: linear-gradient(165deg, #6e4c2d 0%, #563a22 52%, #47301c 100%);
      --wl-face-edge: #7f5a37;
      --wl-mortar: #0f0c08;
      --wl-paper: #efe6d4;
      --wl-paper-ink: #2a2116;
      --wl-paper-label: #7a5634;
      --wl-paper-rule: #d8c9ad;
      max-width: 860px;
    }
    .the-walls [hidden] { display: none !important; }

    .the-walls .wl-head { max-width: 760px; margin: 0 auto 1.8em; }
    .the-walls .wl-kick {
      font: 600 0.74rem/1.3 ui-sans-serif, "Segoe UI", system-ui, sans-serif;
      letter-spacing: 0.16em; text-transform: uppercase; color: var(--moss); margin: 0 0 0.9em;
    }
    /* the way back to the bench, in the kicker's type, above it (as on the Road) */
    .the-walls .wl-back-link { font: 600 0.74rem/1.3 ui-sans-serif, "Segoe UI", system-ui, sans-serif; letter-spacing: 0.06em; margin: -0.45em 0 0.25em; }
    .the-walls .wl-back-link a { display: inline-block; padding: 0.45em 0; color: var(--moss); text-decoration-color: rgba(151, 162, 102, 0.5); }
    .the-walls .wl-back-link a:hover { color: var(--amber-soft); }
    .the-walls h1 { margin: 0 0 0.35em; font-size: clamp(2rem, 5vw, 3rem); }
    .the-walls .wl-lede { color: var(--ink-soft); font-size: 1.08em; margin: 0; }
    .the-walls a:focus-visible { outline: 2px solid var(--amber); outline-offset: 3px; }

    .the-walls .wl-label {
      font: 600 0.74rem/1.3 ui-sans-serif, "Segoe UI", system-ui, sans-serif;
      letter-spacing: 0.16em; text-transform: uppercase; color: var(--faint); margin: 0 0 0.8em;
    }

    /* the keystone: a wedge at the head of the wall, wider at the top */
    .the-walls .wl-keystone { max-width: 760px; margin: 0 auto 2.4em; text-align: center; }
    .the-walls .wl-key { margin: 0; }
    .the-walls .wl-key-stone {
      margin: 0; border: 0; font-style: normal;
      padding: 1.5em 11% 1.6em;
      background: var(--wl-face);
      clip-path: polygon(0 0, 100% 0, 92% 100%, 8% 100%);
      color: var(--amber-soft);
    }
    .the-walls .wl-key-stone p { margin: 0; font-size: 1.12rem; line-height: 1.55; }
    .the-walls .wl-key-stone strong { color: #fff1d6; }
    .the-walls .wl-key-cap { margin: 0.8em 0 0; font: 600 0.84rem/1.45 ui-sans-serif, "Segoe UI", system-ui, sans-serif; color: var(--ink-soft); letter-spacing: 0.01em; }
    .the-walls .wl-key-note { margin: 0.5em 0 0; color: var(--faint); font-size: 0.95rem; }

    /* the wall: stones set in dark mortar, laid in a running bond on wide screens */
    .the-walls .wl-wall { max-width: 860px; margin: 0 auto; }
    /* the label and intro keep the header's column; the wall itself is a little wider */
    .the-walls .wl-wall > .wl-label { max-width: 760px; margin-left: auto; margin-right: auto; }
    .the-walls .wl-intro { color: var(--ink-soft); margin: 0 auto 1em; max-width: 760px; }
    .the-walls .wl-stones {
      list-style: none; margin: 0; padding: 10px;
      display: grid; grid-template-columns: minmax(0, 1fr); gap: 10px;
      background: var(--wl-mortar); border: 1px solid var(--rule); border-radius: 16px;
    }
    @media (min-width: 761px) {
      .the-walls .wl-stone:nth-child(odd) { margin-right: 7%; }
      .the-walls .wl-stone:nth-child(even) { margin-left: 7%; }
    }
    /* hand-cut: each stone's corners differ a little */
    .the-walls .wl-stone { min-width: 0; border-radius: 12px 9px 13px 10px; overflow: hidden; border: 1px solid var(--wl-face-edge); background: var(--wl-paper); }
    .the-walls .wl-stone:nth-child(3n+2) { border-radius: 9px 13px 10px 12px; }
    .the-walls .wl-stone:nth-child(3n) { border-radius: 13px 10px 12px 9px; }

    .the-walls .wl-face {
      margin: 0; padding: 18px 20px; background: var(--wl-face);
      box-shadow: inset 0 1px 0 rgba(255, 226, 180, 0.14);
      font: 600 1.15rem/1.35 ui-sans-serif, "Segoe UI", system-ui, sans-serif; letter-spacing: 0;
      color: var(--amber-soft);
    }
    /* once the script has made the face a button, the button carries the padding */
    .the-walls .is-live .wl-face { padding: 0; }
    .the-walls .wl-turn {
      display: flex; align-items: center; justify-content: space-between; gap: 0.6em 1em; flex-wrap: wrap;
      width: 100%; min-height: 64px; margin: 0; padding: 18px 20px; text-align: left;
      font: inherit; color: inherit; background: transparent; border: 0; border-radius: 0; cursor: pointer;
    }
    .the-walls .wl-turn:hover .wl-rule { color: #fff1d6; }
    .the-walls .wl-turn:focus-visible { outline: 2px solid var(--amber); outline-offset: -4px; border-radius: 9px; }
    .the-walls .wl-hint {
      flex: none; padding: 0.3em 0.75em; border: 1px solid rgba(244, 214, 160, 0.45); border-radius: 999px;
      font: 600 0.78rem/1.2 ui-sans-serif, "Segoe UI", system-ui, sans-serif; letter-spacing: 0.04em;
      color: #f0d3a2; background: rgba(20, 14, 8, 0.28);
    }
    .the-walls .wl-turn:hover .wl-hint { border-color: var(--amber-soft); color: #fff1d6; }
    /* a stone lying face up is the face alone; its paper shows once turned */
    .the-walls .is-live:not(.is-turned) { background: transparent; }

    /* the paper back: four parts, two by two where there's room */
    .the-walls .wl-back { background: var(--wl-paper); color: var(--wl-paper-ink); padding: 16px 20px 18px; }
    .the-walls .wl-parts { margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px 24px; }
    .the-walls .wl-part { min-width: 0; }
    .the-walls .wl-part dt {
      margin: 0 0 0.2em; color: var(--wl-paper-label);
      font: 700 0.76rem/1.3 ui-sans-serif, "Segoe UI", system-ui, sans-serif; letter-spacing: 0.1em; text-transform: uppercase;
    }
    .the-walls .wl-part dd { margin: 0; font-size: 0.97rem; line-height: 1.55; }
    .the-walls .wl-back code, .the-walls .wl-history code {
      font: 0.86em/1 ui-monospace, Consolas, monospace; padding: 0.1em 0.3em; border-radius: 4px;
      background: rgba(122, 86, 52, 0.12); color: var(--wl-paper-ink);
    }
    /* a rule that changed keeps both wordings, the old one marked, never struck out */
    .the-walls .wl-history { margin: 16px 0 0; padding: 14px 0 0; border-top: 1px solid var(--wl-paper-rule); }
    .the-walls .wl-history-h { margin: 0 0 0.6em; color: var(--wl-paper-label); font: 700 0.76rem/1.3 ui-sans-serif, "Segoe UI", system-ui, sans-serif; letter-spacing: 0.1em; text-transform: uppercase; }
    .the-walls .wl-versions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
    .the-walls .wl-version { min-width: 0; padding: 10px 12px; border: 1px solid var(--wl-paper-rule); border-radius: 8px; background: #f6efe1; }
    .the-walls .wl-version.is-old { background: transparent; border-style: dashed; color: #4e4130; }
    .the-walls .wl-version p { margin: 0; font-size: 0.93rem; line-height: 1.5; }
    .the-walls .wl-version .wl-version-h { margin: 0 0 0.3em; font: 600 0.82rem/1.35 ui-sans-serif, "Segoe UI", system-ui, sans-serif; color: var(--wl-paper-ink); }
    .the-walls .wl-tag { color: var(--wl-paper-label); font-weight: 600; }

    @media (prefers-reduced-motion: no-preference) {
      .the-walls .wl-back.is-turning { animation: wl-turn 0.42s cubic-bezier(0.2, 0.7, 0.2, 1); transform-origin: 50% 0; }
    }
    @keyframes wl-turn {
      from { opacity: 0; transform: perspective(1000px) rotateX(-70deg); }
      to { opacity: 1; transform: none; }
    }

    .the-walls .wl-sources { max-width: 760px; margin: 2.6em auto 0; padding-top: 1em; border-top: 1px solid var(--rule); color: var(--faint); font-size: 0.86rem; line-height: 1.55; }
    .the-walls .wl-sources h2 { margin: 0 0 0.5em; font: 600 0.74rem/1.3 ui-sans-serif, "Segoe UI", system-ui, sans-serif; letter-spacing: 0.16em; text-transform: uppercase; color: var(--faint); }
    .the-walls .wl-sources ul { margin: 0; padding-left: 1.1em; }
    .the-walls .wl-sources li { margin: 0 0 0.35em; }
    .the-walls .wl-sources b { color: var(--ink-soft); font-weight: 600; }

    /* phones: one column of stones, and one column inside each back */
    @media (max-width: 600px) {
      .the-walls .wl-key-stone { padding: 1.2em 8% 1.3em; clip-path: polygon(0 0, 100% 0, 95% 100%, 5% 100%); }
      .the-walls .wl-key-stone p { font-size: 1.02rem; }
      .the-walls .wl-stones { padding: 7px; gap: 7px; border-radius: 13px; }
      .the-walls .wl-face, .the-walls .wl-turn { padding: 14px 14px; }
      .the-walls .wl-face { font-size: 1.05rem; }
      .the-walls .wl-back { padding: 14px 14px 16px; }
      .the-walls .wl-parts, .the-walls .wl-versions { grid-template-columns: minmax(0, 1fr); }
    }
  </style>
</BaseLayout>
