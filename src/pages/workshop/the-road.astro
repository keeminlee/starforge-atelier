---
// The Workshop · The Road, chapter one (Atelier campaign, STAR-98). A PROPOSAL page:
// noindex, in no nav and no index, until Darko's go and Rei's read.
// One real change, followed from the first sign to the decision (PR #20, the Forest
// Fire resize fix), with the bug itself to try. The two simulations live in
// public/workshop/the-road/forest-fire/: a frozen copy of the sim as it was at 4c757675
// (the exhibit of the bug) and the fixed sim from 98f41c6d. Nothing loads or runs until
// the visitor presses "Narrow both windows", so it never competes with the page around it.
//
// The demonstration is a change of WIDTH, wide to narrow, the way a window narrows when a
// phone turns upright. The sim sizes its grid from its frame's width (height = width x
// 0.6), and the bug throws only when the grid shrinks. Each frame's height follows the
// sim's own shape (canvas plus the readout's lines at that width), so there are no empty
// bands, and the size changes in one step, so each sim sees one resize, not a
// transition's dozens. Nothing rotates or animates: the buttons name what they do (Rei's
// wording read, 11-02).
//
// Nothing around the comparison moves at the press or the narrowing: the slots, the
// captions, the line under the old copy, the stills note and the second button keep their
// room throughout. The one exception is a screen narrow enough to stack the frames (600px
// and under): there the line under the old copy and a caption's second line take their
// room at the press, not at load, so they aren't an empty band between the frames at
// rest. From the narrowing on, nothing moves.
//
// Error text is shown without hosts: message, function and file only. The live line under
// a frame is cleaned the same way when it's shown.
//
// All styles are global and namespaced under .the-road, since the script builds the
// iframes (Astro's scoped styles never reach script-built DOM).
import BaseLayout from "../../layouts/BaseLayout.astro";

const ASSETS = "/workshop/the-road/forest-fire";
const PR = "https://github.com/keeminlee/starforge-atelier/pull/20";

const errorHead = "RangeError: offset is out of bounds";
// "…/" marks where the local host and path were cut; nothing else is left out
const errorRest = "\n    at Int32Array.set (<anonymous>)\n    at ForestFire.step (…/sim.js:142:19)";

const verdictLines = `VERDICT before: errors=1 allResizesStillRunning=false
VERDICT after: errors=0 allResizesStillRunning=true`;

// the whole hunk, so the header's line counts (6 before, 7 after) match what's shown
const diffLines = `public/atlas/entries/forest-fire/sim.js
@@ -42,6 +42,7 @@
       // spark's blaze can be summed across the many ticks it burns.
       this.fireId = new Int32Array(n);
       this.fireId.fill(-1);
+      this._fireIdNext = null;        // step()'s scratch; re-made at the new size
       this._nextFireId = 0;
       this._fireSize = new Map();     // fireId → running cell count for live fires
       this.lastFireSize = 0;`;

// split here, not in the template: nested markup with "\n" literals inside a template
// expression trips Astro's parser
const NL = String.fromCharCode(10);
const diffRows = diffLines.split(NL).map((text) => ({ text: text + NL, add: text.startsWith("+") }));

// the reviewer's probe output; a "…" line marks lines left out, and "…/" the cut host and path
const reproLines = ` resize -> 390x844: sim width 714 -> 344 (onResize fired: true)
  …
  [after 390x844] ALIVE=false (ticks +0, gridChanged=false)
  …
 S1 page errors: 1
   390x844: RangeError: offset is out of bounds @ at ForestFire.step (…/sim.js:142:19)`;
---
<BaseLayout
  title="The Road, chapter one: the forest that stopped burning — Starforge"
  description="One real fix, followed from the first sign of trouble to a person's decision, with the bug itself to try."
  noindex={true}
>
  <article class="the-road">
    <header class="tr-head">
      <p class="tr-kick">The Workshop · The Road, chapter one</p>
      <h1>The forest that stopped burning</h1>
      <p class="tr-lede">One of the simulations in the <a href="/atelier/atlas-of-emergence/">Atlas of Emergence</a> froze when a narrower window shrank its grid. This page follows the fix from the first sign of trouble to a person's decision.</p>
    </header>

    <section class="tr-card tr-compare" aria-labelledby="tr-compare-h">
      <h2 id="tr-compare-h" class="tr-h2">Try the bug</h2>
      <p class="tr-text">Two copies of the same simulation: the code before the fix, and the code after it. Nothing runs until you press the button. Then both start, and a moment later each frame gets narrower, the way a window does when a phone turns upright. The copy before the fix goes dark and stops. The copy after the fix keeps burning.</p>

      <div class="tr-frames">
        <figure class="tr-frame" data-side="before" data-src={`${ASSETS}/forest-fire-before.html`} data-title="Forest Fire simulation, before the fix">
          <div class="tr-slot">
            <img src={`${ASSETS}/ff-before.png`} width="714" height="428" alt="Still of the copy before the fix, after its window narrowed and widened again: the grid is all black.">
          </div>
          <figcaption><span class="tr-label">before the fix</span> <span class="tr-tick"></span></figcaption>
          <p class="tr-err" hidden></p>
        </figure>
        <figure class="tr-frame" data-side="after" data-src={`${ASSETS}/forest-fire-after.html`} data-title="Forest Fire simulation, after the fix">
          <div class="tr-slot">
            <img src={`${ASSETS}/ff-after.png`} width="714" height="428" alt="Still of the copy after the fix, after the same resizes: a green forest with dark burned patches and amber fire fronts.">
          </div>
          <figcaption><span class="tr-label">after the fix</span> <span class="tr-tick"></span></figcaption>
          <p class="tr-err" hidden></p>
        </figure>
      </div>
      <p class="tr-still-note">The pictures are stills of each copy after its window narrowed and widened again.</p>

      <div class="tr-controls">
        <button type="button" class="tr-btn tr-turn"><span class="tr-turn-label">Narrow both windows</span><span class="tr-sizer" aria-hidden="true">Narrow both windows</span><span class="tr-sizer" aria-hidden="true">Widen both windows</span></button>
        <button type="button" class="tr-btn tr-stop is-idle">Stop and reset</button>
      </div>
      <p class="tr-status" role="status" aria-live="polite"></p>
    </section>

    <section class="tr-road" aria-labelledby="tr-road-h">
      <h2 id="tr-road-h" class="tr-h2">The road</h2>
      <p class="tr-text">Five steps, each with the record it left. Open a step to see it.</p>

      <ol class="tr-stations">
        <li class="tr-station">
          <details>
            <summary><span class="tr-dot" aria-hidden="true">1</span><span class="tr-sum"><b>Noticed</b><span>A crawler resized every page of the site, and one froze.</span></span></summary>
            <div class="tr-body">
              <p>It loaded each of the site's 131 pages at desktop size, then resized it to a phone held upright, a phone held sideways, and back. One page threw an error and stopped moving: the Forest Fire simulation.</p>
              <p class="tr-cap">The error, from the old code on that resize:</p>
              <div class="tr-code"><pre class="tr-artifact" tabindex="0"><code><span class="tr-red">{errorHead}</span>{errorRest}</code></pre></div>
              <p>In that run, the clock stayed at t=111 from then on.</p>
            </div>
          </details>
        </li>

        <li class="tr-station">
          <details>
            <summary><span class="tr-dot" aria-hidden="true">2</span><span class="tr-sum"><b>Defined</b><span>“Done” was written down before the fix was built.</span></span></summary>
            <div class="tr-body">
              <p>Done meant:</p>
              <ul>
                <li>Resize the page from 1440×1000 to 390×844, then 844×390, then back to 1440×1000.</li>
                <li>No error after any resize.</li>
                <li>After each resize, the simulation still moves: its clock and its counts of trees and burning cells change.</li>
              </ul>
              <p class="tr-cap">The check's last line, on the old code and on the fix:</p>
              <div class="tr-code"><pre class="tr-artifact" tabindex="0"><code>{verdictLines}</code></pre></div>
            </div>
          </details>
        </li>

        <li class="tr-station">
          <details>
            <summary><span class="tr-dot" aria-hidden="true">3</span><span class="tr-sum"><b>Built</b><span>One worker built it: a one-line change.</span></span></summary>
            <div class="tr-body">
              <p class="tr-gloss">The worker is a Plumb, named for the plumb line, which shows what's truly vertical.</p>
              <p>The simulation kept a scratch buffer sized for its grid. A resize rebuilt the grid but kept the old buffer. When the grid got smaller, copying the old buffer into it threw the error, and the animation stopped for good. The fix clears the buffer whenever the grid is rebuilt, so it's made again at the right size.</p>
              <p>The error happens only when the grid shrinks, which is why the frames above get narrower.</p>
              <div class="tr-code"><pre class="tr-artifact" tabindex="0"><code>{diffRows.map((r) => (r.add ? <span class="tr-grn">{r.text}</span> : r.text))}</code></pre></div>
              <p><a href={`${PR}/files`}>See the change on GitHub</a></p>
            </div>
          </details>
        </li>

        <li class="tr-station">
          <details>
            <summary><span class="tr-dot" aria-hidden="true">4</span><span class="tr-sum"><b>Checked</b><span>A worker that didn't build it checked it.</span></span></summary>
            <div class="tr-body">
              <p class="tr-gloss">This worker is a Truey: a wall is true when it's plumb, level and square.</p>
              <p>It built the old code and the fix in separate copies and wrote its own test. On the old code, it got the same error, and the clock stopped:</p>
              <div class="tr-code"><pre class="tr-artifact" tabindex="0"><code>{reproLines}</code></pre></div>
              <p>Then it tried three paths the builder hadn't:</p>
              <ol class="tr-paths">
                <li><b>Widen only,</b> from phone to desktop. Neither copy threw an error, but the old code lost track of which fire up to 663 burning cells belonged to. The fix lost none.</li>
                <li><b>Pause, shrink, then play.</b> The old code threw the error. The fix kept running.</li>
                <li><b>Shrink and widen, then reset or randomize.</b> The fix gave no errors.</li>
              </ol>
              <p>Its verdict: pass, with notes, none of them blocking.</p>
            </div>
          </details>
        </li>

        <li class="tr-station">
          <details>
            <summary><span class="tr-dot" aria-hidden="true">5</span><span class="tr-sum"><b>Decided</b><span>Merged and published on 2 November 2026.</span></span></summary>
            <div class="tr-body">
              <p>A person decides whether the fix goes public. On this site a merge publishes, so nothing merges without that go. It was merged on the evening of 2 November 2026, and the Forest Fire simulation in the Atlas runs the fixed code now.</p>
              <p class="tr-artifact"><a href={PR}>Pull request #20</a> · merged</p>
            </div>
          </details>
        </li>
      </ol>

      <p class="tr-text tr-record">The public record is <a href={PR}>pull request #20 on GitHub</a>.</p>
    </section>
  </article>

  <style is:global>
    .the-road {
      --tr-wood: linear-gradient(180deg, var(--bg-3), var(--bg-2));
      --tr-red: #e58a6f;
      max-width: 1120px;
    }
    /* the hidden attribute must win over the display rules below */
    .the-road [hidden] { display: none !important; }
    .the-road .tr-head { max-width: 760px; margin: 0 auto 1.6em; }
    .the-road .tr-kick {
      font: 600 0.74rem/1.3 ui-sans-serif, "Segoe UI", system-ui, sans-serif;
      letter-spacing: 0.16em; text-transform: uppercase; color: var(--moss); margin: 0 0 0.9em;
    }
    .the-road h1 { margin: 0 0 0.35em; font-size: clamp(2rem, 5vw, 3rem); }
    .the-road .tr-lede { color: var(--ink-soft); font-size: 1.08em; margin: 0; }
    .the-road .tr-h2 { margin: 0 0 0.45em; }
    .the-road .tr-text { color: var(--ink-soft); margin: 0 0 1em; }

    /* the comparison: the workshop's warm wood */
    .the-road .tr-card {
      background: var(--tr-wood); border: 1px solid var(--rule); border-radius: 18px;
      padding: 26px 24px 22px;
    }
    .the-road .tr-compare .tr-text { max-width: 760px; }
    /* side by side on wide screens; stacked at 600px and under, before first, so each
       frame can use the column's width */
    .the-road .tr-frames { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px; align-items: start; }
    @media (max-width: 600px) { .the-road .tr-frames { grid-template-columns: minmax(0, 1fr); gap: 18px; } }
    .the-road .tr-frame { margin: 0; min-width: 0; }
    /* the slot keeps the wide frame's height so nothing below moves at the turn; the
       narrowed frame sits centred in it, so the space around it reads as deliberate */
    .the-road .tr-slot { display: flex; align-items: center; justify-content: center; min-width: 0; }
    .the-road .tr-slot img {
      display: block; width: 100%; max-width: 520px; height: auto;
      border: 1px solid var(--rule); border-radius: 10px;
    }
    .the-road .tr-window {
      border: 1px solid var(--rule); border-radius: 10px; overflow: hidden; line-height: 0;
      background: #06070a; max-width: 100%;
    }
    .the-road .tr-window iframe { display: block; border: 0; }
    .the-road .tr-frame figcaption {
      display: flex; flex-wrap: wrap; justify-content: center; gap: 0.2em 0.8em; margin-top: 0.55em;
      font: 600 0.82rem/1.4 ui-sans-serif, "Segoe UI", system-ui, sans-serif; letter-spacing: 0.04em;
      color: var(--ink);
    }
    .the-road .tr-tick { font: 0.78rem/1.4 ui-monospace, Consolas, monospace; color: var(--faint); letter-spacing: 0; }
    .the-road .tr-err {
      margin: 0.35em auto 0; max-width: 520px; text-align: center;
      font: 0.78rem/1.45 ui-monospace, Consolas, monospace; color: var(--tr-red); overflow-wrap: anywhere;
    }
    /* Stacked, the held line (and a caption's held second line) would sit as an empty
       band between the two frames at rest, so there their room is held from the press
       instead: the one shift lands with the press itself, and nothing moves from the
       narrowing on. The script sets each caption's room as an inline min-height. */
    @media (max-width: 600px) {
      .the-road .tr-frames.is-resting .tr-err { display: none; }
      .the-road .tr-frames.is-resting figcaption { min-height: 0 !important; }
    }
    .the-road .tr-still-note { margin: 0.9em 0 0; text-align: center; font-size: 0.85rem; color: var(--faint); }
    /* the first button sits in the middle column, so it's centred whether or not the
       second shows; the second takes the column to its right. Where the two don't fit on
       one line, each takes its own row, centred. */
    .the-road .tr-controls {
      display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); gap: 0.7em;
      margin: 1.1em 0 0.4em; container-type: inline-size;
    }
    .the-road .tr-controls .tr-turn { grid-column: 2; }
    .the-road .tr-controls .tr-stop { grid-column: 3; justify-self: start; }
    @container (max-width: 34em) {
      .the-road .tr-controls .tr-turn,
      .the-road .tr-controls .tr-stop { grid-column: 1 / -1; justify-self: center; }
    }
    .the-road .tr-btn {
      font: 600 0.95rem/1 ui-sans-serif, "Segoe UI", system-ui, sans-serif; letter-spacing: 0.02em;
      color: var(--bg); background: var(--moss); border: 1px solid var(--moss); border-radius: 999px;
      padding: 0.7em 1.4em; cursor: pointer;
    }
    .the-road .tr-btn:hover { background: #aab676; }
    /* the first button is as wide as its longer label at all times, so relabelling it
       doesn't move the buttons */
    .the-road .tr-turn { display: inline-grid; }
    .the-road .tr-turn > span { grid-area: 1 / 1; text-align: center; }
    .the-road .tr-turn .tr-sizer { visibility: hidden; }
    /* before the press, the second button and the stills note keep their room unseen
       (visibility, not display), so nothing moves at the press; an unseen button is out
       of the tab order and the accessibility tree */
    .the-road .tr-stop.is-idle,
    .the-road .tr-still-note.is-running { visibility: hidden; }
    .the-road .tr-btn[aria-disabled="true"] { opacity: 0.6; cursor: progress; }
    .the-road .tr-stop { color: var(--ink); background: transparent; border-color: var(--faint); }
    .the-road .tr-stop:hover { background: var(--bg-3); }
    .the-road .tr-btn:focus-visible,
    .the-road summary:focus-visible,
    .the-road .tr-artifact:focus-visible,
    .the-road a:focus-visible { outline: 2px solid var(--amber); outline-offset: 3px; }
    .the-road .tr-status { min-height: 1.5em; margin: 0.4em auto 0; max-width: 760px; text-align: center; font-size: 0.95rem; color: var(--ink-soft); }

    /* the road: moss, five stations; a pending station (.tr-notyet) is dashed and empty */
    .the-road .tr-road { max-width: 760px; margin: 2.6em auto 0; }
    .the-road .tr-stations { list-style: none; margin: 0.4em 0 1.2em; padding: 0; position: relative; }
    .the-road .tr-station { position: relative; padding: 0 0 0.9em 0; min-width: 0; }
    .the-road .tr-station::before {
      content: ""; position: absolute; left: calc(1.05em - 1px); top: 2.3em; bottom: -0.1em; width: 2px;
      background: var(--moss);
    }
    .the-road .tr-station:has(+ .tr-notyet)::before {
      background: repeating-linear-gradient(180deg, var(--faint) 0 4px, transparent 4px 8px);
    }
    .the-road .tr-station:last-child::before { display: none; }
    .the-road details { border-radius: 12px; min-width: 0; }
    .the-road summary {
      list-style: none; cursor: pointer; display: grid; grid-template-columns: 2.1em minmax(0, 1fr) auto;
      gap: 0.8em; align-items: start; padding: 0.15em 0.2em; border-radius: 10px;
    }
    .the-road summary::-webkit-details-marker { display: none; }
    .the-road summary::after {
      content: "+"; font: 600 1.1rem/1.6 ui-sans-serif, system-ui, sans-serif; color: var(--faint); padding-right: 0.2em;
    }
    .the-road details[open] > summary::after { content: "–"; }
    .the-road .tr-dot {
      display: grid; place-items: center; width: 2.1em; height: 2.1em; border-radius: 50%;
      background: var(--bg-2); border: 2px solid var(--moss); color: var(--moss);
      font: 700 0.85rem/1 ui-sans-serif, system-ui, sans-serif; position: relative; z-index: 1;
    }
    .the-road .tr-sum b { display: block; font: 600 1.02rem/1.35 ui-sans-serif, "Segoe UI", system-ui, sans-serif; color: var(--ink); }
    .the-road .tr-sum span { display: block; color: var(--ink-soft); font-size: 0.98rem; line-height: 1.45; }
    .the-road summary:hover .tr-sum b { color: var(--amber-soft); }
    .the-road .tr-body {
      margin: 0.6em 0 0.4em 2.9em; padding: 0.9em 1.1em; background: var(--tr-wood);
      border: 1px solid var(--rule); border-radius: 12px; font-size: 0.97rem; min-width: 0;
      position: relative; z-index: 1; /* above the road's connector line on narrow screens */
    }
    .the-road .tr-body > :first-child { margin-top: 0; }
    .the-road .tr-body > :last-child { margin-bottom: 0; }
    .the-road .tr-body p, .the-road .tr-body ul, .the-road .tr-body ol { margin: 0 0 0.8em; }
    .the-road .tr-body ul, .the-road .tr-body ol { padding-left: 1.3em; }
    .the-road .tr-gloss { color: var(--faint); font-style: italic; }
    .the-road .tr-cap { color: var(--faint); font-size: 0.9rem; margin-bottom: 0.35em !important; }
    .the-road .tr-paths b { color: var(--ink); }
    /* code scrolls sideways rather than wrapping, so a line stays one line */
    .the-road .tr-artifact {
      display: block; margin: 0 0 0.9em; padding: 0.6em 0.75em; background: #100c07;
      border: 1px solid var(--rule); border-radius: 6px; color: var(--ink-soft);
      font: 0.8rem/1.5 ui-monospace, Consolas, monospace; white-space: pre; overflow-x: auto;
      max-width: 100%;
    }
    .the-road .tr-artifact code { font: inherit; }
    /* A box that's wider than its column says so: a soft fade at its right edge, and
       room at the end of each line once scrolled there. The script sets is-overflowing
       only when the box really overflows (scrollWidth > clientWidth), and at-end once
       it's scrolled to the end, which lifts the fade. Boxes that fit show nothing. */
    .the-road .tr-code { position: relative; margin: 0 0 0.9em; min-width: 0; }
    .the-road .tr-code > .tr-artifact { margin: 0; }
    .the-road .tr-code.is-overflowing > .tr-artifact { padding-right: 2.5em; }
    .the-road .tr-code::after {
      content: ""; position: absolute; top: 1px; right: 1px; bottom: 1px; width: 2.75em;
      /* no transition: the cue is set at load, and nothing may animate before the press */
      border-radius: 0 5px 5px 0; pointer-events: none; opacity: 0;
      background: linear-gradient(to right, rgba(16, 12, 7, 0), #100c07 85%);
    }
    .the-road .tr-code.is-overflowing:not(.at-end)::after { opacity: 1; }
    .the-road .tr-red { color: var(--tr-red); }
    .the-road .tr-grn { color: var(--moss); }

    .the-road .tr-notyet .tr-dot { border-style: dashed; border-color: var(--faint); color: var(--faint); background: transparent; }
    .the-road .tr-notyet .tr-sum b { color: var(--faint); }
    .the-road .tr-notyet .tr-body { background: transparent; border-style: dashed; }
    .the-road .tr-artifact.tr-empty { background: transparent; border-style: dashed; color: var(--faint); white-space: normal; }
    .the-road .tr-record { font-size: 0.95rem; }

    @media (max-width: 480px) {
      .the-road .tr-card { padding: 18px 14px 16px; border-radius: 14px; }
      .the-road .tr-body { margin-left: 0; }
    }
  </style>

  <script>
    // "Narrow both windows": nothing loads until the press. Then both copies load at full
    // width, run for a beat, and narrow in one step, so each sim's own resize code runs
    // once. Each frame's height follows the sim's shape. Everything the status line says is
    // read from the sims themselves.
    const root = document.querySelector(".the-road");
    if (root) {
      const turnBtn = root.querySelector(".tr-turn") as HTMLButtonElement;
      const stopBtn = root.querySelector(".tr-stop") as HTMLButtonElement;
      const status = root.querySelector(".tr-status") as HTMLElement;
      const stillNote = root.querySelector(".tr-still-note") as HTMLElement;
      const NARROW = 0.58; // the narrow width, as a share of the wide one
      const frameBox = root.querySelector(".tr-frames") as HTMLElement;

      type Frame = {
        side: string; src: string; title: string;
        slot: HTMLElement; poster: HTMLImageElement; tick: HTMLElement; err: HTMLElement;
        wrap: HTMLElement | null; iframe: HTMLIFrameElement | null; error: string | null;
        seen: { t: number; ticks: number }[];
      };
      const frames: Frame[] = Array.from(root.querySelectorAll<HTMLElement>(".tr-frame")).map((fig) => ({
        side: fig.dataset.side || "", src: fig.dataset.src || "", title: fig.dataset.title || "",
        slot: fig.querySelector(".tr-slot") as HTMLElement,
        poster: fig.querySelector(".tr-slot img") as HTMLImageElement,
        tick: fig.querySelector(".tr-tick") as HTMLElement,
        err: fig.querySelector(".tr-err") as HTMLElement,
        wrap: null, iframe: null, error: null, seen: [],
      }));

      let state: "idle" | "loading" | "wide" | "narrow" = "idle";
      let poll = 0, beat = 0, verdict = 0, loadedAt = 0;

      const turnLabel = root.querySelector(".tr-turn-label") as HTMLElement;
      const NARROW_LABEL = "Narrow both windows", WIDEN_LABEL = "Widen both windows";
      // The line under the old copy keeps its room from page load, so neither the press
      // nor the error appearing at the narrowing pushes the buttons down. Until a real
      // error arrives it holds the expected message, invisible and hidden from screen
      // readers; the real error replaces it.
      const EXPECTED = "Error inside this frame: RangeError: offset is out of bounds at ForestFire.step (before-sim.js:142)";
      // (On a screen that stacks the frames, this room and the caption's are held from
      // the press, not from load: .tr-frames.is-resting.)
      const reserveErr = (f: Frame) => {
        f.err.textContent = EXPECTED; f.err.style.visibility = "hidden";
        f.err.setAttribute("aria-hidden", "true"); f.err.hidden = false;
      };
      const showErr = (f: Frame, text: string) => {
        f.err.textContent = text; f.err.style.visibility = "";
        f.err.removeAttribute("aria-hidden"); f.err.hidden = false;
      };
      const clearErr = (f: Frame) => {
        f.err.hidden = true; f.err.textContent = ""; f.err.style.visibility = "";
        f.err.removeAttribute("aria-hidden");
      };
      const sim = (f: Frame): any => {
        try {
          const A = (f.iframe?.contentWindow as any)?.Atlas;
          return (A && A.instances && A.instances[0]) || null;
        } catch { return null; }
      };
      // moving = its tick count changed in the last 800 ms
      const moving = (f: Frame) => {
        const now = performance.now();
        const recent = f.seen.filter((s) => now - s.t <= 800);
        return recent.length > 1 && recent[recent.length - 1].ticks !== recent[0].ticks;
      };
      // dark = nothing lit on its canvas (a sampled share of pixels brighter than the ground)
      const dark = (f: Frame) => {
        try {
          const c = f.iframe?.contentDocument?.querySelector("#stage canvas") as HTMLCanvasElement | null;
          if (!c || !c.width || !c.height) return false;
          const d = (c.getContext("2d") as CanvasRenderingContext2D).getImageData(0, 0, c.width, c.height).data;
          for (let k = 0; k < d.length; k += 4 * 7) if (d[k] + d[k + 1] + d[k + 2] > 90) return false;
          return true;
        } catch { return false; }
      };
      // An error as shown on this page: its message, then the function and file it came
      // from, never a host or a path.
      const clean = (err: any) => {
        const head = err && err.name ? `${err.name}: ${err.message}` : String(err);
        const stack = String((err && err.stack) || "");
        const m = stack.match(/at ([\w$.]+) \((?:[^()]*\/)?([^/()]+?):(\d+):\d+\)/);
        const where = m ? ` at ${m[1]} (${m[2]}:${m[3]})` : "";
        return (head + where).replace(/[a-z][\w+.-]*:\/\/[^\s)]*\//gi, "");
      };
      // The line under each canvas (the exhibits' strip.js) wraps between its fields and
      // always shows the clock, the tree cover and the burning count. Its height at a
      // width is however many lines those take at their widest, measured here in the
      // line's own type (exhibit.css .road-strip; the font is the atlas's --mono).
      const NB = String.fromCharCode(160);
      const STRIP_WIDEST = ["t=999999", "cover 100.0%", "burning 99999"].map((s) => s.split(" ").join(NB)).join(NB + "· ");
      const stripProbe = document.createElement("p");
      stripProbe.setAttribute("aria-hidden", "true");
      Object.assign(stripProbe.style, {
        position: "absolute", visibility: "hidden", left: "0", top: "0", margin: "0",
        padding: "3px 8px 4px", boxSizing: "border-box", fontSize: "11px", lineHeight: "15px",
        fontFamily: '"SFMono-Regular", "JetBrains Mono", "Consolas", ui-monospace, monospace',
      });
      stripProbe.textContent = STRIP_WIDEST;
      // held in a box of no size that clips, so the probe never widens the page
      const probeHold = document.createElement("div");
      Object.assign(probeHold.style, { position: "absolute", width: "0", height: "0", overflow: "hidden" });
      probeHold.append(stripProbe);
      root.append(probeHold);
      const stripH = (w: number) => { stripProbe.style.width = w + "px"; return stripProbe.offsetHeight; };
      const dims = () => {
        const wide = Math.max(120, Math.min(520, Math.floor(frames[0].slot.clientWidth) - 2));
        const narrow = Math.round(wide * NARROW);
        const h = (w: number) => Math.round(w * 0.6) + stripH(w);
        return { wide, narrow, h };
      };
      // The caption's room: as many lines as the longest it will say needs at this width
      // ("before the fix" and "t=… · dark and stopped" wrap onto two lines on some
      // screens), so a longer caption at the narrowing moves nothing below it.
      const CAPTION_WIDEST = ["t=999 · dark and stopped", "t=99999 · stopped"];
      const holdCaptions = () => {
        let need = 0;
        for (const f of frames) {
          const cap = f.tick.parentElement as HTMLElement, was = f.tick.textContent;
          cap.style.removeProperty("min-height");
          for (const text of CAPTION_WIDEST) { f.tick.textContent = text; need = Math.max(need, cap.offsetHeight); }
          f.tick.textContent = was;
        }
        for (const f of frames) (f.tick.parentElement as HTMLElement).style.minHeight = need + "px";
      };
      // one step: width and height set together, once. The slot always holds the taller
      // of the wide and the narrow frame, from page load, whether it shows a still or a frame.
      const shape = (orient: "wide" | "narrow") => {
        const { wide, narrow, h } = dims();
        const w = orient === "narrow" ? narrow : wide;
        for (const f of frames) {
          f.slot.style.minHeight = Math.max(h(wide), h(narrow)) + 2 + "px";
          if (!f.iframe) continue;
          f.iframe.style.width = w + "px";
          f.iframe.style.height = h(w) + "px";
        }
        holdCaptions();
      };
      // the resting state: stills in full-height slots, the error line's room held
      const rest = () => {
        frameBox.classList.add("is-resting");
        shape("wide");
        for (const f of frames) { if (f.side === "before") reserveErr(f); else clearErr(f); }
      };
      const sample = () => {
        const now = performance.now();
        for (const f of frames) {
          const s = sim(f);
          if (!s) continue;
          f.seen.push({ t: now, ticks: s.ticks });
          if (f.seen.length > 12) f.seen.shift();
          // "stopped" is the bug's state: the sim still says it's running, but its clock
          // doesn't move. "paused" is the atlas pausing a sim that's scrolled out of view.
          let word = "";
          if (state !== "loading" && !moving(f)) word = !s.running ? " · paused" : dark(f) ? " · dark and stopped" : " · stopped";
          f.tick.textContent = `t=${s.ticks}${word}`;
          // A copy that isn't moving keeps the last line its sim wrote under the canvas,
          // counts and all, so the line says what the caption says instead. A sim that
          // moves again writes its own line over this (strip.js).
          if (word) strip(f, f.tick.textContent, `t=${s.ticks}`);
        }
      };
      // a frame too small for the whole line gets the clock alone; the caption has the rest
      const strip = (f: Frame, text: string, short: string) => {
        try {
          const el = f.iframe?.contentDocument?.querySelector("#stage .road-strip") as HTMLElement | null;
          if (!el) return;
          if (el.textContent !== text) el.textContent = text;
          if (el.scrollHeight > el.clientHeight + 1 || el.scrollWidth > el.clientWidth + 1) el.textContent = short;
        } catch { /* same-origin frames; nothing to do if it fails */ }
      };
      const describe = (f: Frame) => {
        const s = sim(f);
        const who = f.side === "before" ? "The copy before the fix" : "The copy after the fix";
        if (!s) return `${who} hasn't loaded.`;
        if (moving(f)) return `${who} is still running.`;
        if (!s.running) return `${who} is paused while it's out of view.`;
        const how = dark(f) ? "has gone dark and stopped" : "has stopped";
        return `${who} ${how} at t=${s.ticks}` + (f.error ? ", after an error." : ".");
      };
      const report = (orient: "wide" | "narrow") => {
        clearTimeout(verdict);
        verdict = window.setTimeout(() => {
          const lead = orient === "narrow" ? "Narrowed both frames." : "Widened both frames again.";
          const stuck = frames.some((f) => { const s = sim(f); return s && s.running && !moving(f); });
          status.textContent = [lead, describe(frames[0]), describe(frames[1]),
            stuck ? "A stopped copy stays stopped; “Stop and reset” clears both." : ""].join(" ").trim();
        }, 1600);
      };
      const turn = (orient: "wide" | "narrow") => {
        state = orient;
        turnBtn.removeAttribute("aria-disabled");
        turnLabel.textContent = orient === "narrow" ? WIDEN_LABEL : NARROW_LABEL;
        status.textContent = orient === "narrow" ? "Narrowing both frames." : "Widening both frames again.";
        shape(orient);
        report(orient);
      };
      const load = () => {
        state = "loading";
        loadedAt = performance.now();
        frameBox.classList.remove("is-resting");
        turnBtn.setAttribute("aria-disabled", "true");
        stopBtn.classList.remove("is-idle");
        stillNote.classList.add("is-running");
        status.textContent = "Loading both copies. They run at full width for a moment, then narrow.";
        for (const f of frames) {
          const wrap = document.createElement("div");
          wrap.className = "tr-window";
          const ifr = document.createElement("iframe");
          ifr.src = f.src;
          ifr.title = f.title;
          f.wrap = wrap; f.iframe = ifr; f.error = null; f.seen = [];
          if (f.side === "before") reserveErr(f); else clearErr(f);
          ifr.addEventListener("load", () => {
            try {
              const w = ifr.contentWindow as any;
              w.addEventListener("error", (e: ErrorEvent) => {
                // only a thrown exception counts; the browser's "ResizeObserver loop"
                // notice arrives as an error event with no error object, and isn't one
                if (!e.error) return;
                f.error = clean(e.error);
                showErr(f, `Error inside this frame: ${f.error}`);
              });
              // The atlas keeps a sim paused under prefers-reduced-motion; pressing
              // "Narrow both windows" is the visitor asking for it to run.
              const s = sim(f);
              if (s && !s.running) s.play();
            } catch { /* same-origin frames; nothing to do if it fails */ }
          });
          f.poster.hidden = true;
          wrap.append(ifr);
          f.slot.append(wrap);
        }
        shape("wide");
        // On a phone the stacked frames can sit above the button that was pressed. Bring
        // them into view, so the visitor sees both, and the atlas doesn't pause one as
        // off screen.
        const box = (root.querySelector(".tr-frames") as HTMLElement).getBoundingClientRect();
        if (box.top < 0 || box.bottom > window.innerHeight) {
          const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
          (root.querySelector(".tr-frames") as HTMLElement).scrollIntoView({ block: "nearest", behavior: still ? "auto" : "smooth" });
        }
        poll = window.setInterval(sample, 200);
        // the beat: both copies have stepped a while at full width (so the old copy's
        // scratch buffer exists at that size), or 6 s have passed
        const wait = () => {
          if (state !== "loading") return;
          const ready = frames.every((f) => { const s = sim(f); return s && s.ticks >= 40; });
          const elapsed = performance.now() - loadedAt;
          if ((ready && elapsed >= 1500) || elapsed >= 6000) turn("narrow");
          else beat = window.setTimeout(wait, 150);
        };
        beat = window.setTimeout(wait, 150);
      };
      const stop = () => {
        clearInterval(poll); clearTimeout(beat); clearTimeout(verdict);
        const hadFocus = document.activeElement === stopBtn;
        for (const f of frames) {
          if (f.iframe) f.iframe.src = "about:blank";
          if (f.wrap) f.wrap.remove();
          f.wrap = null; f.iframe = null; f.seen = []; f.error = null;
          f.poster.hidden = false;
          f.tick.textContent = "";
        }
        state = "idle";
        rest();
        turnBtn.removeAttribute("aria-disabled");
        turnLabel.textContent = NARROW_LABEL;
        stopBtn.classList.add("is-idle");
        stillNote.classList.remove("is-running");
        status.textContent = "Stopped and reset. Nothing is running.";
        if (hadFocus) turnBtn.focus();
      };

      turnBtn.addEventListener("click", () => {
        if (state === "idle") load();
        else if (state === "wide") turn("narrow");
        else if (state === "narrow") turn("wide");
        // while loading, the turn comes on its own
      });
      stopBtn.addEventListener("click", stop);

      // Code boxes: the scroll cue shows only on a box that overflows. Measured without
      // the cue's own end padding, so the padding can't keep the cue on.
      const codes = Array.from(root.querySelectorAll<HTMLElement>(".tr-code"));
      const pre = (w: HTMLElement) => w.querySelector("pre") as HTMLElement;
      const atEnd = (w: HTMLElement) => {
        const p = pre(w);
        w.classList.toggle("at-end", w.classList.contains("is-overflowing") && p.scrollLeft + p.clientWidth >= p.scrollWidth - 1);
      };
      const measure = (w: HTMLElement) => {
        const p = pre(w);
        w.classList.remove("is-overflowing");
        const over = p.clientWidth > 0 && p.scrollWidth > p.clientWidth + 1;
        w.classList.toggle("is-overflowing", over);
        atEnd(w);
      };
      const measureAll = () => codes.forEach(measure);
      for (const w of codes) pre(w).addEventListener("scroll", () => atEnd(w), { passive: true });
      root.querySelectorAll("details").forEach((d) => d.addEventListener("toggle", measureAll));
      window.addEventListener("resize", measureAll);
      measureAll();
      window.addEventListener("resize", () => {
        shape(state === "narrow" ? "narrow" : "wide");
      });
      rest();
    }
  </script>
</BaseLayout>
