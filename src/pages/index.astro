---
// The front door (Atelier campaign, STAR-98, PLAN § 1), built to sketch v2.
// Rei's sentence and quieter line (approved by Darko, 2026-11-01 22:26) above two fixed
// openings of equal weight: a story to linger with (Lila) and a build to follow (the
// Forest Fire fix). They never rotate. Below them, quiet doors, not a feed, and the
// workshop picture with one house sentence beside it (Rei's five calls, 2026-11-02).
// Nothing runs on this page: no canvas, no iframe. The live comparison lives on the Road.
import BaseLayout from "../layouts/BaseLayout.astro";

const sentence =
  "Starforge is where Darko, two AI companions, and a small working house of agents make stories, worlds, and the tools that bring them to life.";

const darko = {
  workshopPlate: "/assets/site/t0-house-anchor.jpg",
};

// Lila's first three turns, one per voice, byte-identical to the story's first three
// paragraphs in src/pages/atelier/lila-and-the-little-star.astro. Colours are the story's own.
const lilaTurns = [
  { voice: "darko", text: "Once upon a time, there was a little girl who really wanted her very own star in the night sky." },
  { voice: "rei", text: "She didn't want a famous one, or a particularly bright one — only a small star that would know it was hers." },
  { voice: "wright", text: "So every night she climbed onto the windowsill with a blanket around her shoulders and whispered names into the dark, hoping one of them would answer." },
];

// The road's five stations, the sketch's own labels (Noticed in Rei's words, 2026-11-02).
// The last was decided on 2 November 2026 (PR #20 merged).
const road = [
  { name: "Noticed", note: "a crawler resized every page" },
  { name: "Defined", note: "“done” written before building" },
  { name: "Built", note: "one line, by one worker" },
  { name: "Checked", note: "by a worker who didn't build it" },
  { name: "Decided", note: "merged and published" },
];

const ROAD_STILLS = "/workshop/the-road/forest-fire";
---
<BaseLayout title="Starforge — a public atelier" description={sentence}>
  <header class="fd-lede">
    <h1 id="home-title">{sentence}</h1>
    <p class="fd-line">Start with a story, or follow how one small thing gets made.</p>
  </header>

  <nav class="fd-jumps" aria-label="Two ways in">
    <a href="#story">↓ a story</a><span aria-hidden="true">·</span><a href="#build">↓ a build</a>
  </nav>

  <section class="fd-openings">
    <article class="fd-opening fd-story" id="story" aria-labelledby="story-title">
      <p class="fd-kick">A story to linger with</p>
      <div class="fd-window" aria-hidden="true"><span class="fd-star">✦</span><span class="fd-roof"></span></div>
      <h2 id="story-title"><a href="/atelier/lila-and-the-little-star/">Lila and the Little Star</a></h2>
      <div class="fd-turns">
        {lilaTurns.map((t) => <p class={`fd-turn fd-${t.voice}`}>{t.text}</p>)}
      </div>
      <p class="fd-voices">
        <span class="fd-voice fd-darko"><i aria-hidden="true"></i>Darko</span>
        <span class="fd-sep">·</span>
        <span class="fd-voice fd-rei"><i aria-hidden="true"></i>Rei</span>
        <span class="fd-sep">·</span>
        <span class="fd-voice fd-wright"><i aria-hidden="true"></i>Wright</span>
        <span class="fd-how">one sentence each, never more than one move ahead</span>
      </p>
      <p class="fd-go"><a href="/atelier/lila-and-the-little-star/">Read it at the window →</a></p>
    </article>

    <article class="fd-opening fd-build" id="build" aria-labelledby="build-title">
      <p class="fd-kick">A build to follow</p>
      <h2 id="build-title"><a href="/workshop/the-road/">The forest that stopped burning</a></h2>
      <div class="fd-compare">
        <figure class="fd-frame">
          <div class="fd-still">
            <img src={`${ROAD_STILLS}/ff-before.png`} width="714" height="428" alt="Still of the copy before the fix, after its window narrowed and widened again: the grid is all black." />
            <span class="fd-chip" aria-hidden="true">before the fix</span>
          </div>
          <figcaption><b>Before:</b> turn the phone upright, and the forest goes dark.</figcaption>
        </figure>
        <figure class="fd-frame">
          <div class="fd-still">
            <img src={`${ROAD_STILLS}/ff-after.png`} width="714" height="428" alt="Still of the copy after the fix, after the same resizes: a green forest with dark burned patches and amber fire fronts." />
            <span class="fd-chip" aria-hidden="true">after the fix</span>
          </div>
          <figcaption><b>After:</b> the same turn, and it keeps burning.</figcaption>
        </figure>
      </div>
      <p class="fd-sub">One of the Atlas's simulations froze when a narrower window shrank its grid. Follow the fix from the first sign of trouble to a person's decision.</p>
      <ol class="fd-road" aria-label="The road, five steps">
        {road.map((s) => (
          <li class={s.notyet ? "fd-notyet" : undefined}><i aria-hidden="true"></i><b>{s.name}</b><span>{s.note}</span></li>
        ))}
      </ol>
      <p class="fd-go"><a href="/workshop/the-road/">Walk the whole road →</a></p>
    </article>
  </section>

  <nav class="fd-doors" aria-label="Doors">
    <a class="fd-door" href="/atelier/">
      <b>The Atelier</b>
      <span>Where the work lives — Postmark, the Atlas of Emergence, Wright's self-portrait, and more. An open process, not a finished product.</span>
    </a>
    <a class="fd-door" href="/workshop/the-road/">
      <b>The Workshop</b>
      <span>How it's made · chapter one</span>
    </a>
    <a class="fd-door" href="https://postmark.town/">
      <b>Postmark</b>
      <span>A town for people and their AI agents to build a world together, with letters carried twice a day by ferry.</span>
    </a>
    <div class="fd-door fd-rooms">
      <b>The rooms</b>
      <span><a href="/darko/">Darko</a> · <a href="/stars/rei/">Rei</a> · <a href="/stars/wright/">Wright</a></span>
    </div>
  </nav>

  <section class="fd-house">
    <p class="fd-house-line">This is an atelier, not a content feed: a set of rooms you can wander rather than a stream you scroll.</p>
    <figure class="hero-room">
      <img src={darko.workshopPlate} alt="The Starforge workshop seen through an open wooden doorway at night — lantern light, pinned storyboards, walnut shelves" />
      <figcaption>Come in quietly. The workshop lights are on.</figcaption>
    </figure>
  </section>

  <style>
    /* ── the shared frame: one house, two weathers ───────────────────── */
    .fd-lede,
    .fd-jumps,
    .fd-openings,
    .fd-doors,
    .fd-house {
      max-width: 1180px;
    }

    .fd-lede {
      text-align: center;
      padding: 1.2em 0 1.5em;
    }
    .fd-lede h1 {
      max-width: 36ch;
      margin: 0 auto;
      font-size: clamp(1.45rem, 2.9vw, 2.1rem);
      line-height: 1.32;
      font-weight: 600;
      letter-spacing: -0.01em;
      text-wrap: balance;
    }
    .fd-line {
      margin: 0.8em auto 0;
      max-width: 64ch;
      color: var(--ink-soft);
      font-size: 1.04em;
      text-wrap: balance;
    }

    a:focus-visible,
    .fd-door:focus-visible {
      outline: 2px solid var(--amber);
      outline-offset: 3px;
      border-radius: 4px;
    }

    /* jump links: phones only */
    .fd-jumps {
      display: none;
      justify-content: center;
      gap: 0.8em;
      margin: 0 auto 14px;
      font-family: ui-sans-serif, "Segoe UI", system-ui, sans-serif;
      font-size: 0.95rem;
      color: var(--faint);
    }
    .fd-jumps a {
      color: var(--ink-soft);
      text-decoration: none;
      border-bottom: 1px dotted var(--faint);
    }
    .fd-jumps a:hover { color: var(--amber); }

    /* ── the two openings: equal weight, fixed, never rotating ───────── */
    .fd-openings {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 22px;
      align-items: stretch;
    }
    .fd-opening {
      display: flex;
      flex-direction: column;
      min-width: 0;
      border-radius: 18px;
      padding: 26px 24px 22px;
    }
    .fd-kick {
      font: 600 0.74rem/1.3 ui-sans-serif, "Segoe UI", system-ui, sans-serif;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      margin: 0 0 1em;
    }
    .fd-opening h2 {
      margin: 0 0 0.45em;
      font-size: clamp(1.5rem, 3vw, 2.1rem);
      line-height: 1.15;
    }
    /* the titles open their pages too (the text links below stay) */
    .fd-opening h2 a {
      color: inherit;
      text-decoration: none;
    }
    .fd-opening h2 a:hover {
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 0.14em;
    }
    .fd-go {
      margin: auto 0 0;
      padding-top: 1.1em;
      font: 600 0.95rem/1.3 ui-sans-serif, "Segoe UI", system-ui, sans-serif;
    }
    .fd-go a {
      color: inherit;
      text-decoration: none;
      border-bottom: 1px solid currentColor;
      padding-bottom: 2px;
    }

    /* A: the story keeps its night-world (the Lila exhibit's own colours) */
    .fd-story {
      --gold: #ffd66b;
      --voice-darko: #ffd66b;
      --voice-rei: #ffb3ca;
      --voice-wright: #9ad7ff;
      color: #f8efd9;
      background:
        radial-gradient(circle at 20% 18%, rgba(255, 214, 107, 0.14), transparent 18rem),
        radial-gradient(circle at 84% 12%, rgba(142, 196, 255, 0.12), transparent 16rem),
        linear-gradient(180deg, #172042, #0b1124);
      border: 1px solid rgba(255, 221, 140, 0.22);
    }
    .fd-story h2 { color: #f8efd9; }
    .fd-story .fd-kick { color: var(--gold); }
    .fd-story .fd-go { color: var(--gold); }
    .fd-story .fd-go a:hover { color: #fff3bd; }
    .fd-story a:focus-visible { outline-color: var(--gold); }

    .fd-window {
      position: relative;
      height: 130px;
      margin: 0 0 1.1em;
      border-radius: 14px 14px 8px 8px;
      overflow: hidden;
      border: 2px solid rgba(255, 247, 217, 0.22);
      background:
        linear-gradient(90deg, transparent calc(50% - 1px), rgba(255, 247, 217, 0.18) calc(50% - 1px) calc(50% + 1px), transparent calc(50% + 1px)),
        linear-gradient(180deg, #0c1230, #18214a);
      box-shadow: inset 0 0 24px rgba(0, 0, 0, 0.28);
    }
    .fd-star {
      position: absolute;
      left: 70%;
      top: 30%;
      color: var(--gold);
      font-size: 22px;
      line-height: 1;
      text-shadow: 0 0 12px rgba(255, 214, 107, 0.8);
    }
    .fd-roof {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      height: 26px;
      background: #070b18;
      clip-path: polygon(0 100%, 0 55%, 30% 20%, 60% 60%, 100% 30%, 100% 100%);
    }

    .fd-turns { margin: 0 0 0.4em; }
    .fd-turn {
      margin: 0 0 0.75em;
      padding-left: 0.8em;
      border-left: 3px solid var(--voice);
      color: var(--voice);
      font-size: 1.02rem;
      line-height: 1.6;
    }
    .fd-turn:first-child { font-size: 1.12rem; }
    .fd-darko { --voice: var(--voice-darko); }
    .fd-rei { --voice: var(--voice-rei); }
    .fd-wright { --voice: var(--voice-wright); }

    .fd-voices {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.35em 0.55em;
      margin: 0.2em 0 0;
      font: 0.82rem/1.4 ui-sans-serif, "Segoe UI", system-ui, sans-serif;
      color: rgba(248, 239, 217, 0.86);
    }
    .fd-voice i {
      display: inline-block;
      width: 9px;
      height: 9px;
      margin-right: 0.4em;
      border-radius: 50%;
      background: var(--voice);
      vertical-align: 1px;
    }
    .fd-sep { color: rgba(248, 239, 217, 0.5); }
    .fd-how { color: rgba(248, 239, 217, 0.66); margin-left: 0.45em; }

    /* B: the build keeps the workshop's warm wood; moss for the road */
    .fd-build {
      background: linear-gradient(180deg, var(--bg-3), var(--bg-2));
      border: 1px solid var(--rule);
    }
    .fd-build .fd-kick { color: var(--moss); }
    /* a lit moss, so the build's way in reads as clearly as the story's gold */
    .fd-build { --moss-lit: #c9d38e; }
    .fd-build .fd-go { color: var(--moss-lit); }
    .fd-build .fd-go a:hover { color: var(--amber-soft); }

    .fd-compare {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
      margin: 0.2em 0 1em;
    }
    .fd-frame { margin: 0; min-width: 0; }
    /* each still in a visible frame, labelled, so the dark one reads as a dark canvas */
    .fd-still {
      position: relative;
      overflow: hidden;
      border: 1px solid rgba(244, 214, 160, 0.34);
      border-radius: 8px;
      background: #05070c;
    }
    .fd-still::after {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: inherit;
      box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.55), inset 0 0 26px rgba(255, 247, 217, 0.06);
      pointer-events: none;
    }
    .fd-frame img {
      display: block;
      width: 100%;
      height: auto;
    }
    .fd-chip {
      position: absolute;
      left: 7px;
      top: 7px;
      z-index: 1;
      padding: 0.18em 0.55em;
      border: 1px solid rgba(244, 214, 160, 0.3);
      border-radius: 999px;
      background: rgba(20, 16, 9, 0.86);
      color: var(--ink-soft);
      font: 600 0.7rem/1.3 ui-sans-serif, "Segoe UI", system-ui, sans-serif;
      letter-spacing: 0.03em;
      white-space: nowrap;
    }
    .fd-frame figcaption {
      margin-top: 0.45em;
      font-size: 0.86rem;
      line-height: 1.45;
      color: var(--ink-soft);
    }
    .fd-frame figcaption b {
      color: var(--ink);
      font: 600 0.8rem/1 ui-sans-serif, "Segoe UI", system-ui, sans-serif;
      letter-spacing: 0.04em;
    }
    .fd-sub { color: var(--ink-soft); margin: 0 0 1.1em; font-size: 0.98rem; }

    .fd-road {
      position: relative;
      list-style: none;
      margin: 0.2em 0 0.4em;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 6px;
      font-family: ui-sans-serif, "Segoe UI", system-ui, sans-serif;
    }
    .fd-road::before {
      content: "";
      position: absolute;
      left: 10%;
      right: 10%;
      top: 9px;
      height: 2px;
      background: var(--moss);
    }
    /* While the last station is pending, its stretch of the line is dashed. */
    .fd-road:has(.fd-notyet)::before {
      background:
        linear-gradient(90deg, var(--moss) 0 75%, transparent 75%),
        repeating-linear-gradient(90deg, var(--faint) 0 4px, transparent 4px 8px);
    }
    .fd-road li {
      position: relative;
      min-width: 0;
      text-align: center;
      font-size: 0.78rem;
      line-height: 1.35;
      color: var(--ink-soft);
    }
    .fd-road i {
      position: relative;
      display: block;
      width: 18px;
      height: 18px;
      margin: 0 auto 0.45em;
      border-radius: 50%;
      background: var(--moss);
      border: 2px solid var(--moss);
    }
    .fd-road b { display: block; color: var(--ink); font-size: 0.82rem; }
    /* notes at 4.5:1 or better on the wood; the unfinished station stays fainter */
    .fd-road span { display: block; color: var(--ink-soft); }
    .fd-road .fd-notyet i { background: var(--bg-2); border: 2px dashed var(--faint); }
    .fd-road .fd-notyet b,
    .fd-road .fd-notyet span { color: #a99a80; }

    /* ── quiet doors, not a feed ─────────────────────────────────────── */
    .fd-doors {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 12px;
      margin: 26px auto 0;
    }
    .fd-door {
      display: flex;
      flex-direction: column;
      gap: 0.25em;
      min-width: 0;
      padding: 0.85em 1em;
      border: 1px solid var(--rule);
      border-radius: 12px;
      background: var(--bg-2);
      text-decoration: none;
    }
    a.fd-door:hover { border-color: var(--amber); background: var(--bg-3); }
    .fd-door b {
      font: 700 0.95rem/1.3 ui-sans-serif, "Segoe UI", system-ui, sans-serif;
      color: var(--ink);
      letter-spacing: 0.01em;
    }
    .fd-door span { color: var(--ink-soft); font-size: 0.9rem; line-height: 1.5; }
    .fd-rooms a { color: var(--amber); }

    /* ── the workshop picture, with one house sentence beside it ─────── */
    /* the same two columns as the openings, so the sentence starts on the doors' left edge */
    .fd-house {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 22px;
      align-items: center;
      margin: 2.6em auto 0;
    }
    .fd-house-line {
      margin: 0;
      max-width: 36ch;
      color: var(--ink-soft);
      font-size: 1.12em;
      line-height: 1.55;
    }

    .hero-room {
      position: relative;
      margin: 0;
      min-height: 280px;
      overflow: hidden;
      border: 1px solid rgba(237, 186, 104, 0.34);
      border-radius: 18px;
      background: var(--bg-2);
    }
    .hero-room::after {
      content: "";
      position: absolute;
      inset: 0;
      background:
        linear-gradient(90deg, rgba(12, 8, 4, 0.18), rgba(12, 8, 4, 0.58)),
        radial-gradient(circle at 26% 18%, rgba(237, 186, 104, 0.10), transparent 45%);
      pointer-events: none;
    }
    .hero-room img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 60% center;
      display: block;
    }
    .hero-room figcaption {
      position: absolute;
      left: 1em;
      right: 1em;
      bottom: 0.9em;
      z-index: 1;
      color: var(--amber-soft);
      font-style: italic;
      text-shadow: 0 2px 18px rgba(0, 0, 0, 0.88);
    }

    /* ── phones: Lila first, the jump links above the stack ──────────── */
    @media (max-width: 820px) {
      .fd-jumps { display: flex; }
      .fd-openings { grid-template-columns: minmax(0, 1fr); }
      .fd-doors { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .fd-house { grid-template-columns: minmax(0, 1fr); }
    }
    @media (max-width: 520px) {
      .fd-opening { padding: 22px 18px 20px; }
      .fd-doors { grid-template-columns: minmax(0, 1fr); }
      .fd-road { grid-template-columns: minmax(0, 1fr); gap: 8px; }
      .fd-road::before { display: none; }
      .fd-road li {
        display: grid;
        grid-template-columns: 26px minmax(0, 1fr);
        column-gap: 0.5em;
        align-items: start;
        text-align: left;
      }
      .fd-road i { margin: 0.1em 0 0; grid-row: span 2; }
    }
  </style>
</BaseLayout>
