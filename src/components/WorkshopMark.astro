---
// The Workshop · one chapter's small object (Atelier campaign, STAR-98; the integration
// brief, item 1). The bench's cards and the front door's bench in miniature both draw
// these, so the two show the same objects. Each is drawn from its chapter's own page, in
// that page's colours: a peg on the pegboard (the Hands), a stone turned to its paper back
// (the Walls), a small tree with its root at the top (the Memory), and a slice of the
// cutaway's layers (the Rig). Decorative: the card's title says which chapter it is.
interface Props {
  piece: "hands" | "walls" | "memory" | "rig";
  class?: string;
}
const { piece, class: cls } = Astro.props;
---
<svg class:list={["ws-mark", cls]} viewBox="0 0 48 36" width="48" height="36" aria-hidden="true" focusable="false">
  {piece === "hands" && (
    <g>
      {/* the pegboard, its holes, and one tool on its peg: a moss top edge, a ringed hole */}
      <rect x="0.5" y="0.5" width="47" height="35" rx="5" fill="#2a2015" stroke="#382d1d" />
      {[6, 14, 22, 30, 38].map((x) => <circle cx={x + 2} cy="5.5" r="1.3" fill="#0d0a06" />)}
      {[6, 14, 22, 30, 38].map((x) => <circle cx={x + 2} cy="31" r="1.3" fill="#0d0a06" />)}
      <rect x="8.5" y="10.5" width="31" height="15" rx="2.5" fill="#1d1710" stroke="#382d1d" />
      <rect x="8.5" y="10.5" width="31" height="2.6" rx="1.2" fill="#97a266" />
      <circle cx="15" cy="18.6" r="2.4" fill="#0d0a06" stroke="#97a266" stroke-width="1.3" />
      <rect x="20" y="17.6" width="14" height="2" rx="1" fill="#cdbda4" opacity="0.7" />
    </g>
  )}
  {piece === "walls" && (
    <g>
      {/* dark mortar, one hand-cut stone: its brown face above, its paper back below */}
      <defs>
        <linearGradient id="ws-mark-stone" x1="0" y1="0" x2="0.35" y2="1">
          <stop offset="0" stop-color="#6e4c2d" />
          <stop offset="0.52" stop-color="#563a22" />
          <stop offset="1" stop-color="#47301c" />
        </linearGradient>
      </defs>
      <rect x="0.5" y="0.5" width="47" height="35" rx="5" fill="#0f0c08" stroke="#382d1d" />
      <path d="M8.5 5.5 H39 Q43 5.5 43 9 V26.5 Q43 30.5 39.5 30.5 H9 Q5 30.5 5 27 V9.5 Q5 5.5 8.5 5.5 Z" fill="#efe6d4" stroke="#7f5a37" />
      <path d="M8.5 5.5 H39 Q43 5.5 43 9 V18.5 H5 V9.5 Q5 5.5 8.5 5.5 Z" fill="url(#ws-mark-stone)" />
      <rect x="9.5" y="10.5" width="20" height="2.2" rx="1.1" fill="#f4d6a0" opacity="0.75" />
      <rect x="9.5" y="22" width="25" height="1.3" rx="0.6" fill="#d8c9ad" />
      <rect x="9.5" y="25.6" width="18" height="1.3" rx="0.6" fill="#d8c9ad" />
    </g>
  )}
  {piece === "memory" && (
    <g>
      {/* the root at the top in moss, one step away in amber, further off dashed */}
      <rect x="15.5" y="1.5" width="17" height="8" rx="2.5" fill="#261d13" stroke="#97a266" stroke-width="1.5" />
      <line x1="24" y1="9.5" x2="24" y2="14" stroke="#97a266" stroke-width="1.4" />
      <line x1="14" y1="14" x2="34" y2="14" stroke="#97a266" stroke-width="1.4" />
      <rect x="7.5" y="14" width="13" height="6.5" rx="2" fill="#261d13" stroke="#edba68" />
      <rect x="27.5" y="14" width="13" height="6.5" rx="2" fill="#261d13" stroke="#edba68" />
      <line x1="24" y1="20.5" x2="24" y2="27" stroke="#93826a" stroke-width="1.2" stroke-dasharray="2 2" />
      <line x1="9" y1="27" x2="39" y2="27" stroke="#93826a" stroke-width="1.2" stroke-dasharray="2 2" />
      <rect x="2.5" y="27" width="12" height="6.5" rx="2" fill="none" stroke="#93826a" stroke-dasharray="2 1.6" />
      <rect x="18" y="27" width="12" height="6.5" rx="2" fill="none" stroke="#93826a" stroke-dasharray="2 1.6" />
      <rect x="33.5" y="27" width="12" height="6.5" rx="2" fill="none" stroke="#93826a" stroke-dasharray="2 1.6" />
    </g>
  )}
  {piece === "rig" && (
    <g>
      {/* the cutaway's five layers, cut apart by dashed lines: pods, the pool's band, the
          guard's dashed gate, the three bells, the flow; the first layer lit, as at load */}
      <rect x="0.5" y="0.5" width="47" height="35" rx="5" fill="#120e08" stroke="#382d1d" />
      <rect x="1" y="1.5" width="1.8" height="5.8" fill="#97a266" />
      {[5.5, 18, 30.5].map((x) => <rect x={x} y="2.4" width="11.5" height="4" rx="1.2" fill="#17130d" stroke="#f4d6a0" stroke-width="0.8" />)}
      {[8.2, 15.1, 22, 28.9].map((y) => <line x1="1" y1={y} x2="47" y2={y} stroke="#382d1d" stroke-width="1" stroke-dasharray="2 1.5" />)}
      <rect x="5.5" y="9.6" width="37" height="4" rx="1.2" fill="#1d1710" stroke="#97a266" stroke-width="0.8" />
      {[10, 15, 20, 25, 30, 35].map((x) => <line x1={x + 0.5} y1="10" x2={x + 0.5} y2="13.2" stroke="#262013" stroke-width="1.6" />)}
      <rect x="5.5" y="16.5" width="37" height="4" rx="1.2" fill="none" stroke="#edba68" stroke-width="0.9" stroke-dasharray="2 1.2" />
      <circle cx="17" cy="25.5" r="1.9" fill="#b5c27a" />
      <circle cx="24" cy="25.5" r="1.9" fill="#f4d6a0" />
      <circle cx="31" cy="25.5" r="1.9" fill="#e58a6f" />
      <line x1="8" y1="32.4" x2="40" y2="32.4" stroke="#97a266" stroke-width="1" />
      {[8, 16, 24, 32, 40].map((x) => <circle cx={x} cy="32.4" r="1.5" fill="#cdbda4" />)}
    </g>
  )}
</svg>

<style>
  .ws-mark { display: block; flex: none; width: 48px; height: 36px; }
</style>
