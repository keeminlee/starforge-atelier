---
// The Workshop · the path through the chapters (Atelier campaign, STAR-98; the integration
// brief, item 2). One link at the foot of each chapter, in the bench's order: the Road, the
// Hands, the Walls, the Memory, the Rig, and from the Rig back to the bench, worded as the
// tour's end. The arrow is for the eye; the link's name is its words.
const ORDER = [
  { href: "/workshop/the-road/", title: "The Road" },
  { href: "/workshop/the-hands/", title: "The Hands" },
  { href: "/workshop/the-walls/", title: "The Walls" },
  { href: "/workshop/the-memory/", title: "The Memory" },
  { href: "/workshop/the-rig/", title: "The Rig" },
];

interface Props {
  from: string; // the chapter's own path, as in ORDER
}
const { from } = Astro.props;
const i = ORDER.findIndex((c) => c.href === from);
if (i < 0) throw new Error(`[WorkshopNext] no chapter at ${from}`);
const next = ORDER[i + 1];
---
<p class="ws-next">
  {next
    ? <a href={next.href}>Next in the Workshop: {next.title}<span aria-hidden="true"> →</span></a>
    : <a href="/workshop/">That's the whole Workshop. Back to the bench<span aria-hidden="true"> →</span></a>}
</p>

<style>
  /* the Road's and the chapters' way-on type: the lit moss of "Walk the whole road →". It
     keeps the reading column of the page's foot: 760px, or a page's own --ws-next-max */
  .ws-next {
    max-width: var(--ws-next-max, 760px); margin: 2.4em auto 0;
    font: 600 0.95rem/1.3 ui-sans-serif, "Segoe UI", system-ui, sans-serif;
  }
  /* padded to a 24px target, as the back links are */
  .ws-next a {
    display: inline-block; padding: 0.45em 0; color: #c9d38e;
    text-decoration-color: rgba(201, 211, 142, 0.45); text-underline-offset: 2px;
  }
  .ws-next a:hover { color: var(--amber-soft); }
  .ws-next a:focus-visible { outline: 2px solid var(--amber); outline-offset: 3px; }
</style>
